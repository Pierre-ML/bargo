---
import { getImageUrl } from "../../backend/backend.js";

const {
  record,
  recordImage,
  src: srcProp,
  width = 400,
  height = 300,
  alt,
  class: className = "w-full h-full object-cover",
  id,
  style,
} = Astro.props;

const imageURL = srcProp || (recordImage ? getImageUrl(record, recordImage) : null);
const altText  = alt !== undefined ? alt : (record?.nom ?? "");
---

{(imageURL || id) ? (
  <img
    src={imageURL || undefined}
    alt={altText}
    width={width}
    height={height}
    class={className}
    loading="lazy"
    decoding="async"
    id={id}
    style={style}
  />
) : (
  <div class="w-full h-full bg-slate-200 flex items-center justify-center">
    <svg class="w-10 h-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
      <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
    </svg>
  </div>
)}
