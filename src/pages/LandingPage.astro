        <div class="absolute top-0 left-0 h-full w-full lg:max-w-360 lg:left-1/2 lg:-translate-x-1/2">
          <!-- Image -->
          <div class="absolute top-37.5 left-8.5 w-81.25 h-63.75 rounded-1.25 overflow-hidden
                      lg:top-54.5 lg:left-129.25 lg:w-210.75 lg:h-100 lg:rounded-2.5">
            <Image src={valeursImages[i]} alt={v.titre} class="w-full h-full object-cover block" />
          </div>
          <!-- Texte -->
          <div class="absolute top-110 left-8.5 w-66.25 flex flex-col gap-4
                      lg:top-65.25 lg:left-20 lg:w-74 lg:gap-12.25">
            <h3 class="text-black text-4 font-medium tracking-normal leading-snug lg:text-6.25 lg:tracking-[-1px]">{v.titre}</h3>
            <p class="text-black text-sm font-medium leading-tight lg:text-base lg:leading-snug lg:w-69.75">{v.texte}</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Wrapper centré pour les contrôles et le titre -->
  <div class="absolute top-0 left-0 h-full w-full lg:max-w-360 lg:left-1/2 lg:-translate-x-1/2 z-5">
    <h2 id="lp-values-h2"
        class="absolute top-18 left-8.5 w-74.75 text-6.25 font-medium tracking-[-1px] leading-snug
               lg:top-24.5 lg:left-17.75 lg:w-304.75 lg:text-12.5 lg:font-bold lg:tracking-0.75 lg:leading-none
               text-black">
      Ce que vous trouverez en venant chez nous
    </h2>

    <!-- Boutons nav -->
    <button id="lp-val-prev" aria-label="Précédent"
            class="absolute top-149.5 left-71 w-7.75 h-7.75
                   lg:top-143.75 lg:left-20 lg:w-10.75 lg:h-10.75
                   bg-transparent border-0 cursor-pointer flex items-center justify-center hover:scale-110 active:scale-95 transition-transform">
      <div class="absolute inset-1/2 -translate-x-1/2 -translate-y-1/2 w-5.5 h-5.5 lg:w-7.5 lg:h-7.5 bg-neutral-800 rounded-full"></div>
      <Image src={chevronLeftIcon} alt="" width={14} height={14} class="relative z-1 brightness-0 invert" />
    </button>
    <button id="lp-val-next" aria-label="Suivant"
            class="absolute top-149.5 left-82 w-7.75 h-7.75
                   lg:top-143.75 lg:left-35.5 lg:w-10.75 lg:h-10.75
                   bg-transparent border-0 cursor-pointer flex items-center justify-center hover:scale-110 active:scale-95 transition-transform">
      <div class="absolute inset-1/2 -translate-x-1/2 -translate-y-1/2 w-5.5 h-5.5 lg:w-7.5 lg:h-7.5 bg-neutral-800 rounded-full"></div>
      <Image src={chevronRightIcon} alt="" width={14} height={14} class="relative z-1 brightness-0 invert" />
    </button>

    <!-- En savoir plus -->
    <a href="/Apropos"
       class="absolute top-148.25 left-8.5 w-40.5 h-10 text-sm
              lg:top-167.25 lg:left-[calc(75%+43px)] lg:w-59.25 lg:h-15 lg:text-base lg:font-medium
              bg-primary-600 inline-flex items-center justify-center text-white no-underline hover:brightness-110 active:scale-[0.97] transition-all">
      En savoir plus
    </a>
  </div>
</section>

<!-- ========== ÉQUIPE ========== -->
<section id="equipe" class="relative w-full bg-white overflow-hidden lg:h-343.75">

  <!-- Titre & descriptions (mobile) -->
  <h2 class="px-8.5 pt-0 text-6.25 font-medium tracking-[-1px] leading-snug text-black lg:hidden">
    L'équipe derrière Bargo
  </h2>
  <p class="px-8.5 mt-4 text-neutral-500 text-base font-medium leading-snug lg:hidden">
    Bargo est un projet réalisé par une équipe d'étudiants passionnés par le design, le numérique et l'expérience utilisateur.
  </p>
  <p class="px-8.5 mt-4 text-neutral-500 text-base font-medium leading-snug lg:hidden">
    Le projet a été conçu dans le cadre d'un travail de réflexion et de création autour d'une plateforme dédiée à l'organisation des sorties.
  </p>
  <p class="px-8.5 mt-4 text-neutral-500 text-base font-medium leading-snug lg:hidden">
    Notre objectif était d'imaginer une solution simple, moderne et adaptée aux habitudes des étudiants et jeunes adultes.
  </p>

  <!-- Desktop: wrapper centré -->
  <div class="hidden lg:block absolute top-0 left-1/2 -translate-x-1/2 h-full w-full max-w-360">
    <h2 class="absolute top-26.5 left-20 w-164.25 text-12.5 font-bold tracking-0.75 leading-none text-black">
      L'équipe derrière Bargo
    </h2>
    <p class="absolute top-46.25 left-20 w-128.75 text-neutral-500 text-base font-medium leading-snug">
      Bargo est un projet réalisé par une équipe d'étudiants passionnés par le design, le numérique et l'expérience utilisateur.
    </p>
    <p class="absolute top-68.25 left-20 w-101.25 text-neutral-500 text-base font-medium leading-snug">
      Le projet a été conçu dans le cadre d'un travail de réflexion et de création autour d'une plateforme dédiée à l'organisation des sorties.
    </p>
    <p class="absolute top-95.75 left-20 w-74 text-neutral-500 text-base font-medium leading-snug">
      Notre objectif était d'imaginer une solution simple, moderne et adaptée aux habitudes des étudiants et jeunes adultes.
    </p>

    <div class="absolute top-26.5 left-238.75 w-101.25 h-123.75 rounded-2.5 overflow-hidden">
