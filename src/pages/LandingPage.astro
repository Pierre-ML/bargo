---
// @ts-nocheck
import { Image } from 'astro:assets';
import { getCollection, getImageUrl } from '../../backend/backend.js';
import Layout from '../layouts/Layout.astro';
import PbImage from '../components/PbImage.astro';

import chevronLeftIcon  from '../assets/icon/chevron_left.svg';
import chevronRightIcon from '../assets/icon/chevron_right.svg';
import checkIcon        from '../assets/icon/check.svg';
import heroImg     from '../assets/img/landing_page_hero.avif';
import cotelImg    from '../assets/img/cotel.avif';
import carouselImg from '../assets/img/img_carousle-1.avif';
import membre1     from '../assets/img/melvyn_philippon.avif';
import membre2     from '../assets/img/pierre_mouilleseaux_lhuillier.avif';
import membre3     from '../assets/img/alex_ringenbach.avif';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (token && userId) return Astro.redirect('/');

let bars = [];
try { bars = await getCollection('bar', { sort: 'created' }); } catch (_) {}

function truncate(text, n) {
  if (!text) return '';
  const words = text.trim().split(/\s+/);
  if (words.length <= n) return text;
  return words.slice(0, n).join(' ') + '\u2026';
}

const barsData = bars.map(bar => {
  const mainImg     = bar.img?.[0]     ? getImageUrl(bar, bar.img[0])     : '';
  const galerieImg  = bar.galerie?.[0] ? getImageUrl(bar, bar.galerie[0]) : '';
  return {
    id:             bar.id,
    nom:            bar.nom ?? '',
    adresse:        bar.adresse ?? '',
    description:    truncate(bar.description, 15),
    descriptionMob: truncate(bar.description, 10),
    parallaxUrl:    galerieImg || mainImg,
    cardImgUrl:     mainImg    || galerieImg,
  };
});

const valeurs = [
  { titre: 'Convivialité',   texte: "Bargo favorise les moments de partage entre amis. La plateforme est pensée pour rendre les sorties plus simples, agréables et collectives." },
  { titre: 'Sécurité',       texte: "La sécurité est au cœur du projet Bargo. La plateforme aide les utilisateurs à organiser leurs sorties tout en facilitant un retour plus serein après la soirée." },
  { titre: 'Responsabilité', texte: "Le projet encourage une approche responsable des sorties. Bargo propose des outils qui aident les utilisateurs à mieux anticiper leurs déplacements et leurs décisions." },
];
const valeursImages = [cotelImg, heroImg, carouselImg];
---

<Layout title="Bargo — Sortez organisés, rentrez en sécurité">

<!-- ========== HERO ========== -->
<section class="relative w-full h-157.5 lg:h-171.25 overflow-hidden">
  <Image src={heroImg} alt="" class="absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-linear-to-b from-[rgba(30,30,30,0.7)] to-neutral-800"></div>

  <!-- Wrapper centré -->
  <div class="absolute top-0 left-0 h-full w-full lg:max-w-360 lg:left-1/2 lg:-translate-x-1/2">
    <h1 class="absolute top-37.5 left-3.25 w-90 text-8.75 leading-[1.2] tracking-0.525
               lg:top-77.25 lg:-translate-y-1/2 lg:left-20 lg:w-259.5 lg:text-22.5 lg:leading-none lg:tracking-1.35
               text-white uppercase">
      Sortez organisés rentrez en sécurité
    </h1>

    <p class="absolute top-93.75 left-3.25 w-66.25 text-3.5 leading-tight
              lg:top-130.25 lg:left-20 lg:w-128.75 lg:text-base lg:leading-snug
              text-white font-medium">
      Bargo est la première plateforme qui simplifie l'organisation des soirées entre amis tout en garantissant un retour sécurisé à la maison.
    </p>

    <a href="/connexion"
       class="absolute top-134.25 left-3.25 w-50 h-10 text-3.5 font-medium
              lg:top-136 lg:left-[calc(75%-16px)] lg:w-74 lg:h-15 lg:text-base lg:font-bold
              bg-primary-600 inline-flex items-center justify-center text-white no-underline hover:brightness-110 active:scale-[0.97] transition-all">
      Découvrir Bargo
    </a>
  </div>
</section>

<!-- ========== CE QUE BARGO ========== -->
<section id="produit" class="relative w-full bg-neutral-200 lg:bg-white overflow-hidden lg:h-288.25">

  <!-- Titre mobile -->
  <h2 class="px-4.75 pt-12 pb-6 text-6.25 font-medium tracking-[-1px] leading-snug text-black lg:hidden">
    Ce que Bargo permet de faire
  </h2>

  <!-- Feat 1 & 2 (mobile) -->
  <div class="flex flex-col gap-6 px-7 lg:hidden pb-6">
    <div class="flex flex-col gap-2.5">
      <h3 class="text-black text-4 font-bold tracking-normal leading-snug">Planifiez votre soirée facilement</h3>
      <p class="text-neutral-500 text-3.5 font-medium leading-tight">Créez une sortie en quelques clics. Choisissez les bars, définissez l'ordre des étapes et préparez votre parcours pour la soirée.</p>
    </div>
    <div class="flex flex-col gap-2.5">
      <h3 class="text-black text-4 font-bold tracking-normal leading-snug">Invitez vos amis</h3>
      <p class="text-neutral-500 text-3.5 font-medium leading-tight">Invitez facilement vos amis à rejoindre votre sortie. Chacun peut consulter les informations de la soirée et suivre le parcours prévu.</p>
    </div>
  </div>

  <!-- Image mobile (entre feat 2 et 3) -->
  <div class="block lg:hidden w-full h-76.5 overflow-hidden">
    <Image src={cotelImg} alt="Soirée Bargo" class="w-full h-full object-cover block" />
  </div>

  <!-- Feat 3 & 4 (mobile) -->
  <div class="flex flex-col gap-6 px-7 lg:hidden py-6">
    <div class="flex flex-col gap-2.5">
      <h3 class="text-black text-4 font-bold tracking-normal leading-snug">Découvrez les bars autour de vous</h3>
      <p class="text-neutral-500 text-3.5 font-medium leading-tight">Bargo intègre une sélection de bars disponibles. Consultez les informations essentielles et créez facilement votre parcours pour la soirée.</p>
    </div>
    <div class="flex flex-col gap-2.5 pb-10">
      <h3 class="text-black text-4 font-bold tracking-normal leading-snug">Débloquez des récompenses</h3>
      <p class="text-neutral-500 text-3.5 font-medium leading-tight">Bargo propose un système de badges et de récompenses pour encourager les sorties responsables. Participez à des barathons et débloquez des récompenses au fil de vos soirées.</p>
    </div>
  </div>

  <!-- Desktop : wrapper centré -->
  <div class="hidden lg:block absolute top-0 left-1/2 -translate-x-1/2 h-full w-full max-w-360">
    <h2 class="absolute top-39.25 left-20 w-127 text-12.5 font-bold tracking-0.75 leading-none text-black">
      Ce que Bargo permet de faire
    </h2>
    <div class="absolute top-39.25 left-184 w-176 h-215.5 rounded-b-2.5 overflow-hidden">
      <Image src={cotelImg} alt="Soirée Bargo" class="w-full h-full object-cover block" />
    </div>
    <div class="absolute top-83.5 left-20 w-129 flex flex-col gap-14.75">
      <div class="flex flex-col gap-6.5">
        <h3 class="text-black">Planifiez votre soirée facilement</h3>
        <p class="text-neutral-500 text-base font-medium leading-snug">Créez une sortie en quelques clics. Choisissez les bars, définissez l'ordre des étapes et préparez votre parcours pour la soirée.</p>
      </div>
      <div class="flex flex-col gap-6.5">
        <h3 class="text-black">Invitez vos amis</h3>
        <p class="text-neutral-500 text-base font-medium leading-snug">Invitez facilement vos amis à rejoindre votre sortie. Chacun peut consulter les informations de la soirée et suivre le parcours prévu.</p>
      </div>
      <div class="flex flex-col gap-6.5">
        <h3 class="text-black">Découvrez les bars autour de vous</h3>
        <p class="text-neutral-500 text-base font-medium leading-snug">Bargo intègre une sélection de bars disponibles. Consultez les informations essentielles et créez facilement votre parcours pour la soirée.</p>
      </div>
      <div class="flex flex-col gap-6.5">
        <h3 class="text-black">Débloquez des récompenses</h3>
        <p class="text-neutral-500 text-base font-medium leading-snug">Bargo propose un système de badges et de récompenses pour encourager les sorties responsables. Participez à des barathons et débloquez des récompenses au fil de vos soirées.</p>
      </div>
    </div>
  </div>
</section>

<!-- ========== NOS BARS BANNER ========== -->
<section id="bars" class="relative w-full h-50 lg:h-110 bg-primary-900">
  <!-- Wrapper centré -->
  <div class="absolute top-0 left-0 h-full w-full lg:max-w-360 lg:left-1/2 lg:-translate-x-1/2">
    <h1 class="absolute top-11 left-4.75 text-6.25 font-bold tracking-[-1px] leading-snug
               lg:top-28.25 lg:left-20 lg:text-22.5 lg:tracking-1.35 lg:leading-none
               text-white uppercase whitespace-nowrap">
      NOS BARS
    </h1>
    <p class="absolute top-25 left-6.25 w-83 text-3.5 leading-tight
              lg:top-32 lg:left-184 lg:w-136.75 lg:text-base lg:leading-snug
              text-neutral-200 font-medium">
      Explorez les bars de Montbéliard et choisissez les étapes de votre prochaine tournée. Créez un parcours sur mesure pour une soirée organisée et conviviale.
    </p>
  </div>
</section>

<!-- ========== BAR CAROUSEL ========== -->
{barsData.length > 0 && (
  <section id="lp-bar-carousel" class="relative w-full h-200.5 lg:h-211 overflow-hidden bg-primary-900">

    <!-- Desktop: wrapper centré -->
    <div class="hidden lg:block absolute top-0 left-1/2 -translate-x-1/2 h-full w-full max-w-360">

      <!-- Parallax panel gauche -->
