# URL de l'instance PocketBase (publique). Lue au build via astro:env/server
# (voir astro.config.mjs) ; optionnelle, la valeur par défaut est celle ci-dessous.
# Ne PAS préfixer par PUBLIC_ : ce préfixe injecterait la valeur dans le JS envoyé
# au navigateur. La vraie protection des données, ce sont les API rules de PocketBase.
PB_URL=https://pbbargo.pierre-mouilleseaux-lhuillier.fr
