---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getUtilisateurPublic, etatAmitie, compterAmis, getFavorisPublics, getDateCreationProfil } from '../../lib/db.ts';
import { urlFichier } from '../../lib/stockage.js';
import ImageFichier from '../../components/ImageFichier.astro';
import checkIcon      from '../../assets/icon/check.svg';
import userRemoveIcon from '../../assets/icon/user_remove.svg';
import likeIcon       from '../../assets/icon/like.svg';
import userAddIcon    from '../../assets/icon/user_add.svg';
import instaIcon      from '../../assets/icon/insta.svg';
import facebookIcon from '../../assets/icon/facebook.svg';
import discordIcon  from '../../assets/icon/discord.svg';
import badgeVip     from '../../assets/icon/badge_vip.svg';
import badgePremium from '../../assets/icon/badge_pernuim.svg';
import panierIcon         from '../../assets/icon/panier.svg';
import swatchesPaletteIcon from '../../assets/icon/swatches_palette.svg';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/connexion?redirect=' + encodeURIComponent(Astro.url.pathname));
const userId = user.id;

const { id } = Astro.params;
if (id === userId) return Astro.redirect('/profil');

// Profil public de la cible (jamais d'e-mail)
const u = getUtilisateurPublic(id);
if (!u) return new Response(null, { status: 404 });

const decoKey       = u.decoration?.image ?? null;
const equippedTitre = u.titre?.titre ?? null;
const themeUrl      = urlFichier(u.theme?.image ?? null);

// État d'amitié avec l'utilisateur connecté
const etat = etatAmitie(userId, id);
const isAlreadyFriend         = etat === 'ami';
const requestSentByMe         = etat === 'envoyee';
const requestReceivedFromThem = etat === 'recue';

const amiesCount  = compterAmis(id);
const displayName = [u.prenom, u.nom].filter(Boolean).join(' ') || u.pseudo || 'Utilisateur';
const dateCreation = getDateCreationProfil(id);
const createdAt   = dateCreation
  ? new Date(dateCreation).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })
  : '—';

// Favoris de l'utilisateur cible
const { bars: barsFavori, jeux: jeuxFavori, boissons: boissonsFavori } = getFavorisPublics(id);

// Tab actif
const activeTab = Astro.url.searchParams.get('tab') ?? 'profil';
---

<Layout title={`${displayName} — Bargo`}>
  <section class="bg-neutral-200 overflow-x-hidden">

    <!-- ===== MOBILE PROFILE HEADER ===== -->
    <div class="block lg:hidden px-5 pt-8 pb-6">
      <!-- Retour -->
      <a href="/profil" class="inline-flex items-center gap-2 text-neutral-500 text-3.5 font-medium no-underline hover:opacity-70 transition-opacity mb-5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Retour
      </a>
      <!-- Avatar -->
      <div class="mx-auto relative" style="width:144px; height:144px;">
        <div class="absolute rounded-full" style="width:100px; height:100px; top:50%; left:50%; transform:translate(-50%,-50%);">
          <div class="absolute inset-0 rounded-full" style="border: 8px solid #dfdfdf; z-index:1;"></div>
          <div class="absolute inset-2 rounded-full overflow-hidden" style="z-index:2;">
            {u.avatar
              ? <ImageFichier cle={u.avatar} alt="Avatar" class="w-full h-full object-cover" />
              : <div class="w-full h-full bg-neutral-800 flex items-center justify-center">
                  <span class="text-white font-bold" style="font-size: 36px;">{displayName[0].toUpperCase()}</span>
                </div>
            }
          </div>
        </div>
        {decoKey && (
          <div class="absolute inset-0 pointer-events-none" style="z-index:3;">
            <ImageFichier cle={decoKey} alt="" class="w-full h-full object-contain" />
          </div>
        )}
      </div>
      <h2 class="text-black m-0 mt-4 text-center text-7">{displayName}</h2>
      {equippedTitre && (
        <p class="m-0 text-center text-primary-600 font-bold text-3.5">{equippedTitre}</p>
      )}
      {u.pseudo && (
        <div class="flex items-center justify-center gap-2 mt-1">
          <h3 class="m-0 text-primary-500">{u.pseudo}</h3>
          {u.abonnement === 'VIP'     && <Image src={badgeVip}     alt="VIP"     width={24} height={24} />}
          {u.abonnement === 'Premium' && <Image src={badgePremium} alt="Premium" width={24} height={24} />}
        </div>
      )}
      <p class="m-0 mt-2 text-center text-neutral-800 text-4 font-medium">{amiesCount} ami(e)s</p>
      <div class="mt-3 h-12.5 bg-primary-900 rounded-1.25 flex items-center justify-center gap-4">
        <h3 class="text-white m-0">Points :</h3>
        <h3 class="text-white m-0">{u.points ?? 0}</h3>
      </div>
      {u.description && (
        <div class="mt-4">
          <p class="m-0 text-4 font-medium text-black uppercase">DESCRIPTION</p>
          <p class="m-0 mt-1 text-neutral-500 text-4 font-medium leading-snug">{u.description}</p>
        </div>
      )}
    </div>

    <!-- ===== DESKTOP PROFILE HEADER ===== -->
    <div class="hidden lg:block relative" style="height: 420px;">
      <!-- Photo de profil -->
      <div class="absolute left-20 top-29.75 size-46.75 rounded-full z-2">
        <div class="absolute inset-0 rounded-full" style="border: 15px solid #dfdfdf; z-index:1;"></div>
        <div class="absolute inset-3.75 rounded-full overflow-hidden" style="z-index:2;">
          {u.avatar
            ? <ImageFichier cle={u.avatar} alt="Avatar" class="w-full h-full object-cover" />
            : <div class="w-full h-full bg-neutral-800 flex items-center justify-center">
                <span class="text-white font-bold" style="font-size: 60px;">{displayName[0].toUpperCase()}</span>
              </div>
          }
        </div>
      </div>
      <!-- Décoration desktop -->
      {decoKey && (
        <div class="absolute pointer-events-none" style="z-index:5; width:224px; height:224px; left:calc(80px - 20px); top:calc(119px - 18px + 5px);">
          <ImageFichier cle={decoKey} alt="" class="w-full h-full object-contain" />
        </div>
      )}
      <!-- Titre équipé -->
      {equippedTitre && (
        <p class="absolute m-0 text-primary-600 font-bold text-3.5" style="left: calc(16.67% + 59px); top: 175px;">{equippedTitre}</p>
      )}
      <!-- Retour -->
      <a href="/profil" class="absolute top-8 left-20 inline-flex items-center gap-2 text-neutral-500 text-3.5 font-medium no-underline hover:opacity-70 transition-opacity">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Retour
      </a>
      <!-- Nom -->
      <h2 class="absolute m-0 text-black overflow-hidden text-ellipsis whitespace-nowrap w-86"
        style="left: calc(16.67% + 59px); top: 119px;">
        {displayName}
      </h2>
      <!-- Pseudo -->
      {u.pseudo && (
        <div class="absolute flex items-center gap-2" style="left: calc(16.67% + 59px); top: 185px;">
          <h3 class="m-0 text-primary-500">{u.pseudo}</h3>
          {u.abonnement === 'VIP'     && <Image src={badgeVip}     alt="VIP"     width={28} height={28} />}
          {u.abonnement === 'Premium' && <Image src={badgePremium} alt="Premium" width={28} height={28} />}
        </div>
      )}
      <!-- Ami(e)s -->
      <p class="absolute m-0 text-neutral-800 text-4 font-medium leading-snug"
        style="left: calc(33.33% + 79px); top: 198px;">
        {amiesCount} ami(e)s
      </p>
      <!-- Points badge -->
      <div class="absolute h-16.25 w-86 bg-primary-900 rounded-1.25 shadow-md flex items-center pl-4 gap-4"
        style="left: calc(16.67% + 59px); top: 241px;">
        <h3 class="text-white m-0">Points :</h3>
        <h3 class="text-white m-0">{u.points ?? 0}</h3>
      </div>
      <!-- DESCRIPTION label -->
      <p class="absolute m-0 text-4 font-medium text-black uppercase leading-snug"
        style="left: calc(50% + 17px); top: 127px;">
        DESCRIPTION
      </p>
      <!-- Description text -->
      <p class="absolute m-0 text-neutral-500 text-4 font-medium leading-snug w-155.75"
        style="left: calc(50% + 16px); top: 174px;">
        {u.description || '—'}
      </p>
    </div>

    <!-- Séparateur shadow (desktop only) -->
    <div class="hidden lg:block h-4.5 bg-neutral-200 shadow-md z-3"></div>

    <!-- ===== DEUX COLONNES ===== -->
    <div class="flex flex-col lg:flex-row">

      <!-- SIDEBAR SOMBRE (desktop only) -->
      <div class="hidden lg:block lg:w-94 lg:shrink-0 bg-neutral-800 overflow-y-auto">
        <div class="px-8 pt-6 pb-10 flex flex-col gap-5">

          <!-- Bouton relation -->
          {isAlreadyFriend ? (
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-center gap-2 border-2 text-3.5 font-medium leading-snug h-15 w-59.25 shrink-0" style="border-color:#72c073; color:#72c073;">
                <Image src={checkIcon} alt="" width={14} height={14} style="filter:invert(64%) sepia(54%) saturate(429%) hue-rotate(73deg) brightness(94%) contrast(88%)" />
                Amis
              </div>
              <button id="remove-friend-btn"
                class="flex items-center justify-center gap-2 border-2 border-neutral-500 text-neutral-400 text-3.5 font-medium leading-snug h-15 w-59.25 hover:border-red-400 hover:text-red-400 transition-colors cursor-pointer bg-transparent shrink-0">
                <Image src={userRemoveIcon} alt="" width={14} height={14} class="brightness-0 invert opacity-60 shrink-0" />
                Supprimer l'ami
              </button>
            </div>
          ) : requestReceivedFromThem ? (
            <div class="flex flex-col gap-3">
              <p class="text-neutral-400 text-3 font-medium m-0">Demande reçue</p>
              <button id="accept-btn"
                class="flex items-center justify-center gap-2 text-white text-3.5 font-medium leading-snug h-15 w-59.25 cursor-pointer border-0 hover:opacity-90 transition-opacity shrink-0"
                style="background:#347645;">
                <Image src={checkIcon} alt="" width={14} height={14} class="brightness-0 invert shrink-0" />
                Accepter
              </button>
              <button id="refuse-btn"
                class="flex items-center justify-center gap-2 border-2 border-neutral-500 text-neutral-400 text-3.5 font-medium leading-snug h-15 w-59.25 hover:border-red-400 hover:text-red-400 transition-colors cursor-pointer bg-transparent shrink-0">
                Refuser
              </button>
            </div>
          ) : requestSentByMe ? (
            <div class="flex items-center justify-center gap-2 text-3.5 font-medium leading-snug h-15 w-59.25 shrink-0" style="background:#2c2c2c; color:#646262; border:1px solid #3a3a3a;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#646262" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              Demande envoyée
            </div>
          ) : (
            <button id="send-request-btn"
              class="flex items-center justify-center gap-2 text-white text-3.5 font-medium leading-snug h-15 w-59.25 cursor-pointer border-0 hover:opacity-90 transition-opacity shrink-0"
              style="background:#094736;">
              <Image src={userAddIcon} alt="" width={14} height={14} class="brightness-0 invert shrink-0" />
              Envoyer une demande
            </button>
          )}

          <!-- Réseaux sociaux -->
          {(u.insta || u.facebook || u.discord) && (
            <div class="mt-4 flex flex-col gap-4">
              <p class="text-neutral-400 text-3 font-medium uppercase tracking-widest m-0">Réseaux sociaux</p>
              {u.insta && (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0" style="background:#2c2c2c;">
                    <Image src={instaIcon} alt="" width={16} height={16} class="invert opacity-70" />
                  </div>
                  <span class="text-neutral-300 text-3.5 font-medium">@{u.insta}</span>
                </div>
              )}
              {u.facebook && (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0" style="background:#2c2c2c;">
                    <Image src={facebookIcon} alt="" width={16} height={16} class="invert opacity-70" />
                  </div>
                  <span class="text-neutral-300 text-3.5 font-medium">{u.facebook}</span>
                </div>
              )}
              {u.discord && (
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0" style="background:#2c2c2c;">
                    <Image src={discordIcon} alt="" width={16} height={16} class="invert opacity-70" />
                  </div>
                  <span class="text-neutral-300 text-3.5 font-medium">{u.discord}</span>
                </div>
              )}
            </div>
          )}

        </div>
      </div>

      <!-- CONTENU PRINCIPAL -->
      <div class={`flex-1 bg-neutral-200${themeUrl ? ' theme-active' : ''}`} style={themeUrl ? `background-image:url('${themeUrl}');background-size:cover;background-position:center;background-attachment:local;` : ''}>

        <!-- BARRE D'ONGLETS BLANCHE -->
        <div class="bg-white flex items-stretch lg:px-20 shadow-md h-14 lg:h-25">
          <div id="tab-list" class="relative flex items-stretch flex-1 lg:flex-none h-full overflow-x-auto">
            <button data-tab="profil"
              class="tab-btn flex-1 lg:flex-none lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap flex items-center justify-center">
              <span class="lg:hidden">Profil</span>
              <span class="hidden lg:inline">Profil</span>
            </button>
            <button data-tab="favoris"
              class="tab-btn flex-1 lg:flex-none lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap inline-flex items-center justify-center gap-1.5 lg:gap-2">
              <span class="lg:hidden">Bars</span>
              <span class="hidden lg:inline">Bars favoris</span>
              {barsFavori.length > 0 && (
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary-600 text-white text-2.75 font-bold">{barsFavori.length}</span>
              )}
            </button>
            <button data-tab="jeux"
              class="tab-btn flex-1 lg:flex-none lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap inline-flex items-center justify-center gap-1.5 lg:gap-2">
              <span class="lg:hidden">Jeux</span>
              <span class="hidden lg:inline">Jeux favoris</span>
              {jeuxFavori.length > 0 && (
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary-600 text-white text-2.75 font-bold">{jeuxFavori.length}</span>
              )}
            </button>
            <button data-tab="boissons"
              class="tab-btn flex-1 lg:flex-none lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap inline-flex items-center justify-center gap-1.5 lg:gap-2">
              <span class="lg:hidden">Boissons</span>
              <span class="hidden lg:inline">Boissons favorites</span>
              {boissonsFavori.length > 0 && (
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary-600 text-white text-2.75 font-bold">{boissonsFavori.length}</span>
              )}
            </button>
            <!-- Trait animé -->
            <div id="tab-indicator" class="absolute bottom-0 h-1.5 rounded-full" style="background:#72c073; transition: left 0.3s cubic-bezier(.4,0,.2,1), width 0.3s cubic-bezier(.4,0,.2,1); left:0; width:0;"></div>
          </div>
        </div>

        <!-- ============================= -->
        <!-- PANEL : PROFIL               -->
        <!-- ============================= -->
        <div id="panel-profil" data-panel class={activeTab !== 'profil' ? 'hidden' : ''}>
          <div class="px-4 lg:px-20 pt-8 lg:pt-11.25 pb-16 lg:pb-30">

            <!-- H2 Informations + ligne décorative -->
            <div class="flex items-center gap-4 lg:gap-7.5 mb-6 lg:mb-11.25">
              <h2 class="text-black m-0 shrink-0 text-7.5 lg:text-12.5">Informations</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
            </div>

            <!-- Box stats -->
            <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-4 lg:px-7.5 py-5.5 mb-4.5">
              <h3 class="text-black m-0 mb-8.75">Statistiques</h3>
              <div class="flex flex-col lg:flex-row gap-4 lg:gap-25">
                <div class="flex flex-col gap-1">
                  <span class="text-neutral-500 text-4 font-medium leading-snug">Points</span>
                  <span class="text-black text-4 font-medium leading-snug">{u.points ?? 0}</span>
                </div>
                <div class="flex flex-col gap-1">
                  <span class="text-neutral-500 text-4 font-medium leading-snug">Ami(e)s</span>
                  <span class="text-black text-4 font-medium leading-snug">{amiesCount}</span>
                </div>
                <div class="flex flex-col gap-1">
                  <span class="text-neutral-500 text-4 font-medium leading-snug">Âge</span>
                  <span class="text-black text-4 font-medium leading-snug">{u.age ? `${u.age} ans` : '—'}</span>
                </div>
                {u.ville && (
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-snug">Ville</span>
                    <span class="text-black text-4 font-medium leading-snug">{u.ville}</span>
                  </div>
                )}
                <div class="flex flex-col gap-1">
                  <span class="text-neutral-500 text-4 font-medium leading-snug">Membre depuis</span>
                  <span class="text-black text-4 font-medium leading-snug">{createdAt}</span>
                </div>
              </div>
            </div>

            <!-- Box activité -->
            <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-4 lg:px-7.5 py-5.5 mb-4.5">
              <h3 class="text-black m-0 mb-8.75">Activité sur Bargo</h3>
              <div class="flex flex-col lg:flex-row gap-4 lg:gap-25">
                <div class="flex flex-col gap-1">
                  <span class="text-neutral-500 text-4 font-medium leading-snug">Sorties organisées</span>
                  <span class="text-black text-4 font-medium leading-snug">
                    {u.barathon_organiser ? `${u.barathon_organiser} sorties` : '—'}
                  </span>
                </div>
                <div class="flex flex-col gap-1">
                  <span class="text-neutral-500 text-4 font-medium leading-snug">Barathons réalisés</span>
                  <span class="text-black text-4 font-medium leading-snug">
                    {u.barathon_participer ? `${u.barathon_participer} parcours` : '—'}
                  </span>
                </div>
                <div class="flex flex-col gap-1">
                  <span class="text-neutral-500 text-4 font-medium leading-snug">Bars favoris</span>
                  <span class="text-black text-4 font-medium leading-snug">{barsFavori.length}</span>
                </div>
                <div class="flex flex-col gap-1">
                  <span class="text-neutral-500 text-4 font-medium leading-snug">Jeux favoris</span>
                  <span class="text-black text-4 font-medium leading-snug">{jeuxFavori.length}</span>
                </div>
                <div class="flex flex-col gap-1">
                  <span class="text-neutral-500 text-4 font-medium leading-snug">Boissons favorites</span>
                  <span class="text-black text-4 font-medium leading-snug">{boissonsFavori.length}</span>
                </div>
              </div>
            </div>

            <!-- Box réseaux (mobile) -->
            {(u.insta || u.facebook || u.discord) && (
              <div class="lg:hidden bg-white border-0.75 border-neutral-300 rounded-2.5 px-4 py-5.5 mb-4.5">
                <h3 class="text-black m-0 mb-5">Réseaux sociaux</h3>
                <div class="flex flex-col gap-3">
                  {u.insta && (
                    <div class="flex items-center gap-3">
                      <Image src={instaIcon} alt="" width={18} height={18} />
                      <span class="text-black text-4 font-medium">@{u.insta}</span>
                    </div>
                  )}
                  {u.facebook && (
                    <div class="flex items-center gap-3">
                      <Image src={facebookIcon} alt="" width={18} height={18} />
                      <span class="text-black text-4 font-medium">{u.facebook}</span>
                    </div>
                  )}
                  {u.discord && (
                    <div class="flex items-center gap-3">
                      <Image src={discordIcon} alt="" width={18} height={18} />
                      <span class="text-black text-4 font-medium">{u.discord}</span>
                    </div>
                  )}
                </div>
              </div>
            )}

            <!-- Boutons relation (mobile) -->
            <div class="lg:hidden flex flex-col gap-3 mt-4">
              {isAlreadyFriend ? (
                <>
                  <div class="flex items-center justify-center gap-2 h-13 rounded-1.25 text-3.5 font-medium" style="background:rgba(114,192,115,0.1); color:#72c073; border:1.5px solid #72c073;">
                    <Image src={checkIcon} alt="" width={14} height={14} style="filter:invert(64%) sepia(54%) saturate(429%) hue-rotate(73deg) brightness(94%) contrast(88%)" />
                    Amis
                  </div>
                  <button id="remove-friend-btn-mobile"
                    class="flex items-center justify-center gap-2 h-13 rounded-1.25 border-2 border-neutral-400 text-neutral-500 text-3.5 font-medium cursor-pointer bg-transparent hover:border-red-400 hover:text-red-400 transition-colors">
                    Supprimer l'ami
                  </button>
                </>
              ) : requestReceivedFromThem ? (
                <>
                  <button id="accept-btn-mobile" class="flex items-center justify-center gap-2 h-13 rounded-1.25 text-white text-3.5 font-medium cursor-pointer border-0 hover:opacity-90 transition-opacity" style="background:#347645;">
                    Accepter la demande
                  </button>
                  <button id="refuse-btn-mobile" class="flex items-center justify-center gap-2 h-13 rounded-1.25 border-2 border-neutral-400 text-neutral-500 text-3.5 font-medium cursor-pointer bg-transparent hover:border-red-400 hover:text-red-400 transition-colors">
                    Refuser
                  </button>
                </>
              ) : requestSentByMe ? (
                <div class="flex items-center justify-center gap-2 h-13 rounded-1.25 text-3.5 font-medium" style="background:#2c2c2c; color:#646262; border:1px solid #3a3a3a;">
                  Demande envoyée
                </div>
              ) : (
                <button id="send-request-btn-mobile" class="flex items-center justify-center gap-2 h-13 rounded-1.25 text-white text-3.5 font-medium cursor-pointer border-0 hover:opacity-90 transition-opacity" style="background:#094736;">
                  Envoyer une demande
                </button>
              )}
            </div>

          </div>
        </div>

        <!-- ============================= -->
        <!-- PANEL : BARS FAVORIS         -->
        <!-- ============================= -->
        <div id="panel-favoris" data-panel class={activeTab !== 'favoris' ? 'hidden' : ''}>
          <div class="px-4 lg:px-20 pt-8 lg:pt-11.25 pb-16 lg:pb-30">

            <div class="flex items-center gap-4 lg:gap-7.5 mb-6 lg:mb-11.25">
              <h2 class="text-black m-0 shrink-0 text-7.5 lg:text-12.5">Bars favoris</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
            </div>

