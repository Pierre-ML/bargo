<div id="drawer-overlay" class="hidden fixed inset-0 bg-black/30 z-70"></div>
<div id="drawer" class="fixed top-0 right-0 h-full w-[min(500px,100vw)] bg-white z-80 overflow-y-auto flex flex-col shadow-[-8px_0_40px_rgba(0,0,0,0.12)]" style="transform:translateX(100%); transition:transform 0.3s cubic-bezier(.4,0,.2,1);">

  <!-- Header -->
  <div class="flex justify-between items-center px-7 py-6 border-b border-gray-100 shrink-0">
    <div>
      <p id="drawer-label" class="text-2.75 font-bold uppercase tracking-widest text-primary-600 m-0 mb-0.75"></p>
      <h3 id="drawer-title" class="text-zinc-900 m-0 text-5"></h3>
    </div>
    <button id="drawer-close" class="bg-zinc-100 border-0 text-zinc-600 text-5 leading-none cursor-pointer w-8.5 h-8.5 rounded-lg flex items-center justify-center">×</button>
  </div>

  <!-- Body -->
  <div id="drawer-body" class="flex-1 p-7"></div>

  <!-- Footer -->
  <div class="px-7 py-5 border-t border-gray-100 shrink-0">
    <p id="drawer-error" class="text-red-500 text-3.25 font-medium mb-3 hidden bg-red-50 py-2.5 px-3.5 rounded-lg"></p>
    <button id="drawer-submit" class="w-full h-11 bg-primary-600 border-0 text-white text-3.5 font-bold cursor-pointer rounded-lg tracking-[0.3px]">Enregistrer</button>
  </div>
</div>

<script is:inline id="page-data" type="application/json" set:html={pageData}></script>
<script>
import '../js/admin.js';
</script>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script define:vars={{ chartData }}>
  function buildDonut(labels, data, colors) {
    return {
      type: 'doughnut',
      data: {
        labels,
        datasets: [{
          data,
          backgroundColor: colors,
          borderWidth: 3,
          borderColor: '#ffffff',
          hoverBorderColor: '#ffffff',
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        cutout: '62%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              font: { size: 11, family: 'Inter, sans-serif' },
              color: '#646262',
              padding: 14,
              boxWidth: 10,
              boxHeight: 10,
              usePointStyle: true,
              pointStyle: 'circle',
            }
          },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                const pct   = total ? Math.round(ctx.parsed / total * 100) : 0;
                return ' ' + ctx.label + ' : ' + ctx.parsed + ' (' + pct + '%)';
              }
            }
          }
        }
      }
    };
  }

  new Chart(
    document.getElementById('chart-abonnements'),
    buildDonut(chartData.abonnements.labels, chartData.abonnements.data, ['#d1d5db', '#7c3aed', '#0891b2'])
  );

  new Chart(
    document.getElementById('chart-sessions'),
    buildDonut(chartData.sessions.labels, chartData.sessions.data, ['#fbbf24', '#22c55e', '#9ca3af'])
  );

  if (chartData.jeux.labels.length > 0) {
    const palette = ['#72c073', '#7c3aed', '#0891b2', '#d97706', '#ef4444', '#ec4899', '#14b8a6'];
    new Chart(
      document.getElementById('chart-jeux'),
      buildDonut(chartData.jeux.labels, chartData.jeux.data, palette.slice(0, chartData.jeux.labels.length))
    );
  }
</script>


</Layout>
