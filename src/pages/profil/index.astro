---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getUserAuth, updateUser, deleteUser, getCollection, getImageUrl, PB_URL } from '../../../backend/backend.js';
import PbImage from '../../components/PbImage.astro';
import heartIcon    from '../../assets/icon/like.svg';
import likeFillIcon from '../../assets/icon/like_fill.svg';
import instaIcon    from '../../assets/icon/insta.svg';
import facebookIcon from '../../assets/icon/facebook.svg';
import discordIcon  from '../../assets/icon/discord.svg';
import badgeVip     from '../../assets/icon/badge_vip.svg';
import badgePremium from '../../assets/icon/badge_pernuim.svg';
import arrowRightLg  from '../../assets/icon/arrow_right_lg.svg';
import bellIcon       from '../../assets/icon/bell.svg';
import notifIcon      from '../../assets/icon/notifcation.svg';
import panierIcon     from '../../assets/icon/panier.svg';
import searchIcon     from '../../assets/icon/search.svg';
import settingsIcon   from '../../assets/icon/settings.svg';

// Auth guard
const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

let updateError   = '';
let updateSuccess = false;
let pwdError      = '';
let pwdSuccess    = false;
let emailError    = '';
let emailSuccess  = false;
let activeTab     = Astro.url.searchParams.get('tab') ?? 'profil';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action   = formData.get('_action')?.toString();

  if (action === 'logout') {
    Astro.cookies.delete('pb_token',   { path: '/' });
    Astro.cookies.delete('pb_user_id', { path: '/' });
    return Astro.redirect('/');
  }

  if (action === 'delete') {
    await deleteUser(userId, token);
    Astro.cookies.delete('pb_token',   { path: '/' });
    Astro.cookies.delete('pb_user_id', { path: '/' });
    return Astro.redirect('/');
  }

  if (action === 'edit') {
    const pbData = new FormData();
    for (const field of ['prenom', 'nom', 'pseudo', 'age', 'ville', 'insta', 'facbook', 'discord', 'description']) {
      const val = formData.get(field);
      if (val !== null && val.toString() !== '') pbData.append(field, val.toString());
    }
    const avatarFile = formData.get('avatar');
    if (avatarFile instanceof File && avatarFile.size > 0) pbData.append('avatar', avatarFile, avatarFile.name);
    const result = await updateUser(userId, token, pbData);
    if (result) { updateSuccess = true; } else { updateError = 'Erreur lors de la mise à jour.'; }
    activeTab = 'profil';
  }

  if (action === 'change_password') {
    const oldPwd     = formData.get('old_password')?.toString()     ?? '';
    const newPwd     = formData.get('new_password')?.toString()     ?? '';
    const confirmPwd = formData.get('confirm_password')?.toString() ?? '';
    if (!oldPwd || !newPwd || !confirmPwd) {
      pwdError = 'Tous les champs sont requis.';
    } else if (newPwd !== confirmPwd) {
      pwdError = 'Les mots de passe ne correspondent pas.';
    } else if (newPwd.length < 8) {
      pwdError = 'Le mot de passe doit contenir au moins 8 caractères.';
    } else {
      const pbData = new FormData();
      pbData.append('oldPassword',     oldPwd);
      pbData.append('password',        newPwd);
      pbData.append('passwordConfirm', confirmPwd);
      const result = await updateUser(userId, token, pbData);
      if (result) { pwdSuccess = true; } else { pwdError = 'Mot de passe actuel incorrect.'; }
    }
    activeTab = 'parametres';
  }

  if (action === 'change_email') {
    const newEmail = formData.get('new_email')?.toString().trim() ?? '';
    if (!newEmail || !newEmail.includes('@')) {
      emailError = 'Adresse email invalide.';
    } else {
      const pbData = new FormData();
      pbData.append('email', newEmail);
      const result = await updateUser(userId, token, pbData);
      if (result) { emailSuccess = true; } else { emailError = 'Erreur lors de la mise à jour.'; }
    }
    activeTab = 'parametres';
  }
}

// Données utilisateur
const user = await getUserAuth(userId, token);
if (!user || user.code === 404) {
  Astro.cookies.delete('pb_token',   { path: '/' });
  Astro.cookies.delete('pb_user_id', { path: '/' });
  return Astro.redirect('/connexion');
}

// Notifications
let notifications = [];
try {
  notifications = await getCollection('notifications', {
    filter:  `user = "${userId}"`,
    sort:    '-created',
    perPage: 50
  });
} catch {}

// Bars découverts
const barDecouver = Array.isArray(user.bar_decouver) ? user.bar_decouver : [];
let totalBars = 0;
try {
  const bRes = await fetch(`${PB_URL}/api/collections/bar/records?perPage=1`);
  if (bRes.ok) { const bd = await bRes.json(); totalBars = bd.totalItems ?? 0; }
} catch {}

// Bars favoris (tous)
let barsFavori = [];
try {
  const favIds = Array.isArray(user.bar_favori) ? user.bar_favori : [];
  if (favIds.length > 0) {
    const filterStr = favIds.map(id => `id="${id}"`).join('||');
    barsFavori = await getCollection('bar', { filter: filterStr, perPage: 200 });
  }
} catch {}

// Jeux favoris (expand via getUserAuth)
const jeuxFavori = (user.expand?.jeux_favori ?? []);

// Boissons favorites (expand via getUserAuth)
const boissonsFavori = (user.expand?.boisson_favori ?? []);

// Invitations de session entrantes
const demandeSession = (user.expand?.demande_session ?? []).map(s => ({
  id: s.id,
  nom: s.nom ?? 'Session sans nom',
  date: s.date_heur_depart?.split(' ')[0] ?? null,
  hote: s.id_hote ?? null,
}));

// Demandes d'amis entrantes (expand already done in getUserAuth)
const demandeAmies = (user.expand?.demande_amies ?? []).map(u => ({
  id: u.id, collectionName: u.collectionName,
  pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '',
  avatar: u.avatar ?? null,
}));
const amiesIds    = Array.isArray(user.amies) ? user.amies : [];
const amiesExpand = (user.expand?.amies ?? []).map(u => {
  const decoRec = u.expand?.equiper_avatar_decoration ?? null;
  const amiDecoUrl = decoRec?.type_decoration_avatar ? getImageUrl(decoRec, decoRec.type_decoration_avatar) : null;
  return {
    id: u.id, collectionName: u.collectionName,
    pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '',
    avatar: u.avatar ?? null, abonnements: u.abonnements ?? 'Gratuit',
    decoUrl: amiDecoUrl,
  };
});

// Tous les utilisateurs pour le modal ami (exclure soi-même)
let allUsers = [];
try {
  const usersRes = await getCollection('users', { sort: 'pseudo', perPage: 200 });
  allUsers = usersRes
    .filter(u => u.id !== userId)
    .map(u => ({
      id: u.id, collectionName: u.collectionName,
      pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '',
      avatar: u.avatar ?? null,
    }));
} catch {}

const avatarUrl    = user.avatar ? getImageUrl(user, user.avatar) : null;

// Items boutique équipés
const decoRecord   = user.expand?.equiper_avatar_decoration ?? null;
const titreRecord  = user.expand?.equiper_titre             ?? null;
const themeRecord  = user.expand?.equiper_theme             ?? null;
const decoUrl      = decoRecord?.type_decoration_avatar  ? getImageUrl(decoRecord,  decoRecord.type_decoration_avatar) : null;
const equippedTitre = titreRecord?.type_titre ?? null;
const themeUrl     = themeRecord?.type_them              ? getImageUrl(themeRecord, themeRecord.type_them)             : null;

// Inventaire boutique
const possedDecorations = (user.expand?.possed_avatar_decoration ?? []).map(item => ({
  id: item.id, nom: item.nom ?? '',
  imageUrl: item.type_decoration_avatar ? getImageUrl(item, item.type_decoration_avatar) : null,
  isEquipped: decoRecord?.id === item.id,
}));
const possedTitres = (user.expand?.possed_titre ?? []).map(item => ({
  id: item.id, nom: item.nom ?? '', type_titre: item.type_titre ?? '',
  isEquipped: titreRecord?.id === item.id,
}));
const possedThemes = (user.expand?.possed_theme ?? []).map(item => ({
  id: item.id, nom: item.nom ?? '',
  imageUrl: item.type_them ? getImageUrl(item, item.type_them) : null,
  isEquipped: themeRecord?.id === item.id,
}));
const itemsFavori = (user.expand?.items_favori ?? []).map(item => ({
  id: item.id, nom: item.nom ?? '', type: item.type ?? '',
  imageUrl: item.type === 'decoration_avatar' ? (item.type_decoration_avatar ? getImageUrl(item, item.type_decoration_avatar) : null)
          : item.type === 'theme'             ? (item.type_them              ? getImageUrl(item, item.type_them)              : null)
          : null,
  type_titre: item.type_titre ?? '',
}));

const createdAt    = user.created
  ? new Date(user.created).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })
  : '—';
const unreadNotifs = notifications.filter(n => !n.lu).length;

function timeAgo(dateStr) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1)  return "À l'instant";
  if (mins < 60) return `Il y a ${mins} min`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Il y a ${hrs}h`;
  return `Il y a ${Math.floor(hrs / 24)}j`;
}

const displayName = user.prenom
  ? `${user.prenom} ${user.nom ?? ''}`.trim()
  : (user.nom ?? user.pseudo ?? '');
---

<Layout title="Mon profil — Bargo">
  <section class="bg-neutral-200 overflow-x-hidden">

    <!-- ===== MOBILE PROFILE HEADER ===== -->
    <div class="block lg:hidden px-5 pt-8 pb-6">
      <!-- Avatar — conteneur large pour la décoration -->
      <div class="mx-auto relative" style="width:144px; height:144px;">
        <!-- Ring + photo : centrés à 100px dans le conteneur de 200px -->
        <div class="absolute rounded-full" style="width:100px; height:100px; top:50%; left:50%; transform:translate(-50%,-50%);">
          <div class="absolute inset-0 rounded-full" style="border: 8px solid #dfdfdf; z-index:1;"></div>
          <div class="absolute inset-2 rounded-full overflow-hidden" style="z-index:2;">
            {avatarUrl
              ? <PbImage src={avatarUrl} alt="Avatar" class="w-full h-full object-cover" />
              : <div class="w-full h-full bg-neutral-800 flex items-center justify-center">
                  <span class="text-white font-bold" style="font-size: 36px;">
                    {(user.pseudo || user.email || '?')[0].toUpperCase()}
                  </span>
                </div>
            }
          </div>
        </div>
        <!-- Décoration : remplit le conteneur de 200px (2× la taille de l'avatar) -->
        {decoUrl && (
          <div class="absolute inset-0 pointer-events-none" style="z-index:3;">
            <PbImage src={decoUrl} alt="" class="w-full h-full object-contain" />
          </div>
        )}
      </div>
      <h2 class="text-black m-0 mt-4 text-center text-7">{displayName}</h2>
      {equippedTitre && (
        <p class="m-0 text-center text-primary-600 font-bold text-3.5">{equippedTitre}</p>
      )}
      <div class="flex items-center justify-center gap-2 mt-1">
        <h3 class="m-0 text-primary-500">{user.pseudo ?? ''}</h3>
        {user.abonnements === 'VIP'     && <Image src={badgeVip}     alt="VIP"     width={24} height={24} />}
        {user.abonnements === 'Premium' && <Image src={badgePremium} alt="Premium" width={24} height={24} />}
      </div>
      <p class="m-0 mt-2 text-center text-neutral-800 text-4 font-medium">{amiesIds.length} ami(e)s</p>
      <div class="mt-3 h-12.5 bg-primary-900 rounded-1.25 flex items-center justify-center gap-4">
        <h3 class="text-white m-0">Points :</h3>
        <h3 class="text-white m-0">{user.points ?? 0}</h3>
      </div>
      {user.description && (
        <div class="mt-4">
          <p class="m-0 text-4 font-medium text-black uppercase">DESCRIPTION</p>
          <p class="m-0 mt-1 text-neutral-500 text-4 font-medium leading-snug">{user.description}</p>
        </div>
      )}
    </div>

    <!-- ===== DESKTOP PROFILE HEADER ===== -->
    <div class="hidden lg:block relative" style="height: 420px;">
      <!-- Photo de profil -->
      <div id="profile-avatar-wrap" class="absolute left-20 top-29.75 size-46.75 rounded-full z-2">
        <!-- Anneau gris -->
        <div class="absolute inset-0 rounded-full" style="border: 15px solid #dfdfdf; z-index:1;"></div>
        <!-- Photo (inset = épaisseur du border) -->
        <div class="absolute inset-3.75 rounded-full overflow-hidden" style="z-index:2;">
          {avatarUrl
            ? <PbImage src={avatarUrl} alt="Avatar" class="w-full h-full object-cover" />
            : <div class="w-full h-full bg-neutral-800 flex items-center justify-center">
                <span class="text-white font-bold" style="font-size: 60px;">
                  {(user.pseudo || user.email || '?')[0].toUpperCase()}
                </span>
              </div>
          }
        </div>
      </div>
      <!-- Décoration desktop : 218px centrés sur l'avatar (187px), légèrement plus bas -->
      {decoUrl && (
        <div class="absolute pointer-events-none" style="z-index:5; width:224px; height:224px; left:calc(80px - 20px); top:calc(119px - 18px + 5px);">
          <PbImage src={decoUrl} alt="" class="w-full h-full object-contain" />
        </div>
      )}
      <!-- Nom -->
      <h2 class="absolute m-0 text-black overflow-hidden text-ellipsis whitespace-nowrap w-86"
        style="left: calc(16.67% + 59px); top: 119px;">
        {displayName}
      </h2>
      <!-- Pseudo -->
      <div class="absolute flex items-center gap-2" style="left: calc(16.67% + 59px); top: 185px;">
        <h3 class="m-0 text-primary-500">{user.pseudo ?? ''}</h3>
        {user.abonnements === 'VIP'     && <Image src={badgeVip}     alt="VIP"     width={28} height={28} />}
        {user.abonnements === 'Premium' && <Image src={badgePremium} alt="Premium" width={28} height={28} />}
      </div>
      <!-- Titre équipé -->
      {equippedTitre && (
        <p class="absolute m-0 text-primary-600 font-bold text-4 leading-snug"
          style="left: calc(16.67% + 59px); top: 215px;">{equippedTitre}</p>
      )}
      <!-- Ami(e)s -->
      <p class="absolute m-0 text-neutral-800 text-4 font-medium leading-snug"
        style="left: calc(33.33% + 79px); top: 198px;">
        {amiesIds.length} ami(e)s
      </p>
      <!-- Points badge -->
      <div class="absolute h-16.25 w-86 bg-primary-900 rounded-1.25 shadow-md flex items-center pl-4 gap-4"
        style="left: calc(16.67% + 59px); top: 241px;">
        <h3 class="text-white m-0">Points :</h3>
        <h3 class="text-white m-0">{user.points ?? 0}</h3>
      </div>
      <!-- DESCRIPTION label -->
      <p class="absolute m-0 text-4 font-medium text-black uppercase leading-snug"
        style="left: calc(50% + 17px); top: 127px;">
        DESCRIPTION
      </p>
      <!-- Description text -->
      <p class="absolute m-0 text-neutral-500 text-4 font-medium leading-snug w-155.75"
        style="left: calc(50% + 16px); top: 174px;">
        {user.description ?? '—'}
      </p>
    </div>

    <!-- Séparateur shadow (desktop only) -->
    <div class="hidden lg:block h-4.5 bg-neutral-200 shadow-md z-3"></div>

    <!-- ===== DEUX COLONNES ===== -->
    <div class="flex flex-col lg:flex-row">

      <!-- SIDEBAR SOMBRE (desktop only) -->
      <div class="hidden lg:block lg:w-94 lg:shrink-0 bg-neutral-800 overflow-y-auto">
        <div class="px-8 pt-6 pb-10 flex flex-col gap-5">

          <!-- Boutique -->
          <a href="/boutique"
            class="flex items-center justify-center border-2 border-white text-white text-4 font-medium leading-snug h-15 w-59.25 hover:bg-white hover:text-neutral-800 transition-colors shrink-0">
            Boutique
          </a>

          <!-- Ajouter des amis -->
          <button id="btn-open-friends"
            class="flex items-center justify-center border-2 border-white text-white text-4 font-medium leading-snug h-15 w-59.25 hover:bg-white hover:text-neutral-800 transition-colors cursor-pointer bg-transparent shrink-0">
            Ajouter des amis
          </button>

          <!-- Liste des amis -->
          {amiesExpand.length > 0 && (
            <div class="flex flex-col gap-5 mt-3">
              {amiesExpand.map(ami => (
                <a href={`/profil/${ami.id}`} class="flex items-center gap-4 no-underline hover:opacity-80 transition-opacity">
                  <div class="relative shrink-0" style="width:96px; height:96px;">
                    <div class="absolute rounded-full overflow-hidden" style="width:64px; height:64px; top:50%; left:50%; transform:translate(-50%,-50%); z-index:1;">
                      {ami.avatar
                        ? <PbImage record={ami} recordImage={ami.avatar} alt={ami.pseudo} class="w-full h-full object-cover" />
                        : <div class="w-full h-full bg-primary-600 flex items-center justify-center">
                            <span class="text-white font-bold text-6">{(ami.pseudo || ami.prenom || '?')[0].toUpperCase()}</span>
                          </div>
                      }
                    </div>
                    {ami.decoUrl && (
                      <div class="absolute inset-0 pointer-events-none" style="z-index:2;">
                        <PbImage src={ami.decoUrl} alt="" class="w-full h-full object-contain" />
                      </div>
                    )}
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <p class="text-white font-bold text-4 m-0 truncate">{ami.pseudo || ''}</p>
                      {ami.abonnements === 'VIP'     && <Image src={badgeVip}     alt="VIP"     width={18} height={18} class="shrink-0" />}
                      {ami.abonnements === 'Premium' && <Image src={badgePremium} alt="Premium" width={18} height={18} class="shrink-0" />}
                    </div>
                    <p class="text-neutral-300 text-3.5 font-medium m-0 truncate">{`${ami.prenom ?? ''} ${ami.nom ?? ''}`.trim()}</p>
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- CONTENU PRINCIPAL -->
      <div class={`flex-1 bg-neutral-200${themeUrl ? ' theme-active' : ''}`} style={themeUrl ? `background-image:url('${themeUrl}');background-size:cover;background-position:center;background-attachment:local;` : ''}>

        <!-- BARRE D'ONGLETS BLANCHE -->
        <div class="bg-white flex items-stretch lg:px-20 shadow-md h-14 lg:h-25">
          <div id="tab-list" class="relative flex items-stretch flex-1 lg:flex-none h-full overflow-x-auto">
            <button data-tab="profil"
              class="tab-btn flex-1 lg:flex-none lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap flex items-center justify-center">
              Mon profil
            </button>
            <button data-tab="amis"
              class="tab-btn lg:hidden flex-1 h-full text-3.5 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap flex items-center justify-center">
              Amis
            </button>
            <button data-tab="inventaire"
              class="tab-btn flex-1 lg:flex-none lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap flex items-center justify-center">
              Inventaire
            </button>
            <button data-tab="notifications"
              class="tab-btn flex-1 lg:flex-none lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 inline-flex items-center justify-center gap-2 whitespace-nowrap">
              <Image src={notifIcon} alt="Notifications" width={20} height={20} class="block lg:hidden" />
              <span class="hidden lg:block">Notifications</span>
              {(unreadNotifs + demandeAmies.length + demandeSession.length) > 0 && (
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-500 text-white text-2.75 font-bold">{unreadNotifs + demandeAmies.length + demandeSession.length}</span>
              )}
            </button>
            <button data-tab="parametres"
              class="tab-btn flex-1 lg:flex-none lg:px-6.25 h-full text-3.5 lg:text-4 font-medium text-black cursor-pointer bg-transparent border-0 whitespace-nowrap flex items-center justify-center">
              <Image src={settingsIcon} alt="Paramètres" width={20} height={20} class="block lg:hidden brightness-0" />
              <span class="hidden lg:block">Paramètres</span>
            </button>
            <!-- Trait animé -->
            <div id="tab-indicator" class="absolute bottom-0 h-1.5 rounded-full" style="background:#72c073; transition: left 0.3s cubic-bezier(.4,0,.2,1), width 0.3s cubic-bezier(.4,0,.2,1); left:0; width:0;"></div>
          </div>

          <!-- Editer / Annuler (desktop only) -->
          <button id="edit-btn"
            class="hidden lg:flex ml-auto bg-primary-600 h-12.75 w-64.25 items-center justify-center text-white text-4 font-medium hover:brightness-110 active:scale-[0.97] transition-all cursor-pointer border-0 self-center">
            Editer le profil
          </button>
          <button id="cancel-btn" style="display: none;"
            class="ml-auto border-2 border-primary-600 text-primary-600 h-12.75 w-64.25 flex items-center justify-center text-4 font-medium hover:bg-primary-600 hover:text-white transition-colors cursor-pointer bg-transparent self-center">
            Annuler
          </button>
        </div>

        <!-- ============================= -->
        <!-- PANEL : MON PROFIL           -->
        <!-- ============================= -->
        <div id="panel-profil" data-panel class={activeTab !== 'profil' ? 'hidden' : ''}>
          <div class="px-4 lg:px-20 pt-8 lg:pt-11.25 pb-16 lg:pb-30">

            {updateSuccess && <p class="text-primary-600 text-sm font-medium mb-6 m-0">Profil mis à jour avec succès.</p>}
            {updateError   && <p class="text-red-500 text-sm font-medium mb-6 m-0">{updateError}</p>}

            <!-- H2 Données du compte + ligne décorative -->
            <div class="flex items-center gap-7.5 mb-11.25">
              <h2 class="text-black m-0 shrink-0">Données du compte</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
            </div>

            <form method="POST" enctype="multipart/form-data" id="profile-form">
              <input type="hidden" name="_action" value="edit" />

              <!-- Box 1 : Informations personnelles -->
              <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-4 lg:px-7.5 py-5.5 mb-4.5">
                <h3 class="text-black m-0 mb-8.75">Informations personnel</h3>
                <div class="flex flex-col lg:flex-row gap-4 lg:gap-25">
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-snug">Ville</span>
                    <span class="view-field text-black text-4 font-medium leading-snug">{user.ville ?? '—'}</span>
                    <input type="text" name="ville" value={user.ville ?? ''} placeholder="Ville"
                      class="edit-field hidden text-4 font-medium text-neutral-800 bg-neutral-200 border border-neutral-300 rounded px-3 py-1 outline-none w-35" />
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-neutral-500 text-4 font-medium leading-snug">Âge</span>
