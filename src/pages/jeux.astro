---
// @ts-nocheck
import Layout from '../layouts/Layout.astro';
import PbImage from '../components/PbImage.astro';
import LikeButton from '../components/LikeButton.astro';
import Pagination from '../components/Pagination.astro';
import HeroSection from '../components/HeroSection.astro';

const PB_URL  = 'https://pbbargo.pierre-mouilleseaux-lhuillier.fr';
const token   = Astro.cookies.get('pb_token')?.value;
const userId  = Astro.cookies.get('pb_user_id')?.value;
const isAuth  = !!(token && userId);
const page    = parseInt(Astro.url.searchParams.get('page') ?? '1');
const perPage = 9; // 3 colonnes × 3 lignes

const res  = await fetch(`${PB_URL}/api/collections/jeux/records?page=${page}&perPage=${perPage}&sort=created`);
const data = await res.json();
const jeux       = data.items ?? [];
const totalPages = Math.ceil((data.totalItems ?? 0) / perPage);

---

<Layout title="Nos jeux — Bargo">

  <HeroSection title="Nos jeux" descMobile="Des défis et jeux à relever tout au long de votre soirée barathon.">
    Ici vous pourrez tester des jeux à faire tout au long de votre soirée. Si vous voulez donner
    votre avis sur les jeux ou si vous avez d'autres idées, n'hésitez pas à nous en parler via
    mail ou via le <a href="/contact" class="underline hover:opacity-70 transition-opacity">formulaire de contact</a>.
  </HeroSection>

  <!-- ===== GRILLE ===== -->
  <div class="bg-neutral-200 px-4 lg:px-20 pt-8 lg:pt-14.5 pb-10 lg:pb-20">
    <div class="lg:max-w-7xl lg:mx-auto">

    {jeux.length > 0 ? (
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:gap-8">
        {jeux.map(jeu => {
          const imageFile = Array.isArray(jeu.img) ? jeu.img[0] : jeu.img;
          return (
            <div class="bg-white rounded-0.5 shadow-md overflow-hidden">

              <!-- Image -->
              <div class="w-full h-50 lg:h-75 overflow-hidden">
                <PbImage record={jeu} recordImage={imageFile} width={405} height={300} class="w-full h-full object-cover" />
              </div>

              <!-- Contenu -->
              <div class="p-4 lg:p-0 lg:relative lg:h-58">

                <!-- Nom -->
                <h3 class="m-0 text-black truncate text-4.5 lg:text-6.25 lg:absolute lg:top-5 lg:left-4.75 lg:right-10">{jeu.nom}</h3>

                <!-- Description -->
                <p class="mt-2 lg:mt-0 text-neutral-500 text-4 font-medium leading-snug m-0 line-clamp-2 lg:absolute lg:top-18.25 lg:left-4.75 lg:w-55">
                  {jeu.description}
                </p>

                <!-- Actions -->
                <div class="mt-3 lg:mt-0 flex items-center gap-3 lg:block">
                  <!-- Bouton Jouer -->
                  {(() => {
                    const href = !isAuth
                      ? '/connexion'
                      : jeu.type_du_jeux === 'questionaire' ? '/jeux_questionaire'
                      : jeu.type_du_jeux === 'memorie'      ? '/jeux_memoire'
                      : jeu.type_du_jeux === 'reflex'       ? '/jeux_reflexe'
                      : jeu.type_du_jeux === 'rythme'       ? '/jeux_rythme'
                      : '#';
                    return (
                      <a href={href}
                        class="flex-1 lg:flex-none lg:absolute lg:top-35.5 lg:bottom-7.5 lg:left-4.75 lg:w-59.25 h-12 lg:h-auto bg-neutral-800 flex items-center justify-center text-white text-4 font-medium hover:bg-primary-900 active:scale-95 transition-all no-underline">
                        {isAuth ? 'Jouer' : 'Se connecter'}
                      </a>
                    );
                  })()}
                  <!-- Like -->
                  {isAuth && (
                    <LikeButton id={jeu.id} variant="jeux" class="lg:absolute lg:top-37.75 lg:right-5.25 w-10.25 h-10.25 flex items-center justify-center shrink-0 bg-transparent border-0 cursor-pointer p-0" ariaLabel="Ajouter aux favoris" />
                  )}
                </div>

              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <p class="text-neutral-500 text-4 font-medium">Aucun jeu disponible pour l'instant.</p>
    )}

    </div><!-- /max-w-7xl -->
  </div>

  <!-- ===== PAGINATION ===== -->
  <Pagination page={page} totalPages={totalPages} currentUrl={Astro.url.href} />

  {isAuth && <div id="auth-meta" data-token={token} data-user-id={userId} hidden></div>}

  <script>
    import '../js/like.js';
  </script>

</Layout>
