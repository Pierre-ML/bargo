  <div class="bg-white w-[min(420px,92vw)] rounded-xl overflow-hidden shadow-2xl">
    <div class="px-7 py-6 border-b border-gray-100">
      <p class="text-2.75 font-bold uppercase tracking-widest text-red-500 m-0 mb-1">Action irréversible</p>
      <h3 id="confirm-title" class="text-zinc-900 m-0 text-5"></h3>
