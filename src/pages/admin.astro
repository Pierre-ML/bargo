    <div class="px-7 py-5">
      <p id="confirm-body" class="text-zinc-600 text-3.5 font-medium m-0 leading-relaxed"></p>
    </div>
    <div class="flex gap-2.5 px-7 pb-6 justify-end">
      <button id="confirm-cancel" class="h-9.5 px-5 bg-white border border-zinc-300 text-zinc-600 text-3.25 font-semibold cursor-pointer rounded-lg">Annuler</button>
      <button id="confirm-ok" class="h-9.5 px-5 bg-red-500 border-0 text-white text-3.25 font-semibold cursor-pointer rounded-lg">Confirmer</button>
    </div>
  </div>
</div>

