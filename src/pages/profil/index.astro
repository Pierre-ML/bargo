                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* ── Titres possédés ── */}
                {possedTitres.length > 0 && (
                  <div>
                    <div class="flex items-center gap-7.5 mb-8">
                      <h3 class="text-black m-0 shrink-0">Titres <span class="text-neutral-500 font-medium">({possedTitres.length})</span></h3>
                      <div class="flex-1 h-0.5 bg-neutral-300"></div>
                    </div>
                    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-8">
                      {possedTitres.map(item => (
                        <div data-inv-card={item.id} class={`bg-white rounded-0.5 shadow-sm overflow-hidden relative${item.isEquipped ? ' ring-2 ring-primary-500' : ''}`}>
                          <div class="h-36 lg:h-44 bg-neutral-500 flex items-center justify-center relative">
                            <div class="size-20 rounded-full bg-primary-900 flex items-center justify-center px-2">
                              <p class="text-white font-bold text-3 text-center m-0 leading-snug">{item.type_titre || item.nom}</p>
                            </div>
                            <span class={`inv-equipped-badge absolute top-2 left-2 bg-primary-500 text-primary-900 text-2.5 font-bold px-2 py-0.5${item.isEquipped ? '' : ' hidden'}`}>Équipé</span>
                          </div>
                          <div class="p-4">
                            <h3 class="m-0 text-black text-sm mb-3 truncate">{item.nom}</h3>
                            <div class={`inv-equipped-state${item.isEquipped ? '' : ' hidden'}`}>
                              <div class="w-full h-8 bg-primary-600 flex items-center justify-center mb-2">
                                <span class="text-white text-3.5 font-medium">✓ Équipé</span>
                              </div>
                              <button class="inv-unequip-btn w-full h-9 border border-neutral-300 text-neutral-500 text-3.5 font-medium bg-transparent cursor-pointer hover:border-neutral-800 hover:text-neutral-800 transition-colors"
                                data-item-id={item.id} data-item-type="titre">Déséquiper</button>
                            </div>
                            <button class={`inv-equip-btn w-full h-12 bg-primary-900 text-white text-4 font-medium border-0 cursor-pointer hover:opacity-90 transition-opacity${item.isEquipped ? ' hidden' : ''}`}
                              data-item-id={item.id} data-item-type="titre">Équiper</button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* ── Thèmes possédés ── */}
                {possedThemes.length > 0 && (
                  <div>
                    <div class="flex items-center gap-7.5 mb-8">
                      <h3 class="text-black m-0 shrink-0">Thèmes <span class="text-neutral-500 font-medium">({possedThemes.length})</span></h3>
                      <div class="flex-1 h-0.5 bg-neutral-300"></div>
                    </div>
                    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-8">
                      {possedThemes.map(item => (
                        <div data-inv-card={item.id} class={`bg-white rounded-0.5 shadow-sm overflow-hidden relative${item.isEquipped ? ' ring-2 ring-primary-500' : ''}`}>
                          <div class="h-36 lg:h-44 bg-neutral-500 flex items-center justify-center relative">
                            {item.imageUrl ? (
                              <div class="size-20 rounded-full overflow-hidden">
                                <PbImage src={item.imageUrl} alt={item.nom} class="w-full h-full object-cover" />
                              </div>
                            ) : (
                              <div class="size-20 rounded-full bg-neutral-600"></div>
                            )}
                            <span class={`inv-equipped-badge absolute top-2 left-2 bg-primary-500 text-primary-900 text-2.5 font-bold px-2 py-0.5${item.isEquipped ? '' : ' hidden'}`}>Équipé</span>
                          </div>
                          <div class="p-4">
                            <h3 class="m-0 text-black text-sm mb-3 truncate">{item.nom}</h3>
                            <div class={`inv-equipped-state${item.isEquipped ? '' : ' hidden'}`}>
                              <div class="w-full h-8 bg-primary-600 flex items-center justify-center mb-2">
                                <span class="text-white text-3.5 font-medium">✓ Équipé</span>
                              </div>
                              <button class="inv-unequip-btn w-full h-9 border border-neutral-300 text-neutral-500 text-3.5 font-medium bg-transparent cursor-pointer hover:border-neutral-800 hover:text-neutral-800 transition-colors"
                                data-item-id={item.id} data-item-type="theme">Déséquiper</button>
                            </div>
                            <button class={`inv-equip-btn w-full h-12 bg-primary-900 text-white text-4 font-medium border-0 cursor-pointer hover:opacity-90 transition-opacity${item.isEquipped ? ' hidden' : ''}`}
                              data-item-id={item.id} data-item-type="theme">Équiper</button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

              </div>
            )}

          </div>

          <div id="inv-toast" style="position:fixed;bottom:100px;left:50%;transform:translateX(-50%) translateY(20px);background:#1E1E1E;color:white;padding:12px 24px;border-radius:8px;font-size:14px;font-family:'Inter',sans-serif;font-weight:500;opacity:0;transition:opacity 0.25s,transform 0.25s;pointer-events:none;z-index:300;white-space:nowrap;"></div>
        </div>

        <!-- ============================= -->
        <!-- PANEL : PARAMÈTRES           -->
        <!-- ============================= -->
        <div id="panel-parametres" data-panel class={activeTab !== 'parametres' ? 'hidden' : ''}>
          <div class="px-4 lg:px-20 pt-8 lg:pt-11.25 pb-16 lg:pb-30">

            <div class="flex flex-col lg:flex-row lg:items-center lg:gap-7.5 mb-8 lg:mb-11.25 gap-3">
              <div class="flex items-center gap-4 lg:contents">
                <h2 class="text-black m-0 shrink-0">Paramètres</h2>
                {user.admin && (
                  <a href="/admin" class="lg:hidden shrink-0 inline-flex items-center justify-center h-10 px-5 bg-primary-900 text-white text-sm font-semibold rounded-sm hover:opacity-80 transition-opacity">
                    Panneau admin
                  </a>
                )}
              </div>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
              {user.admin && (
                <a href="/admin" class="hidden lg:inline-flex shrink-0 items-center justify-center h-10 px-6 bg-primary-900 text-white text-sm font-semibold rounded-sm hover:opacity-80 transition-opacity">
                  Panneau admin
                </a>
              )}
            </div>

            <!-- Email -->
            <h3 class="text-black m-0 mb-5">Email</h3>
            <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-7.5 py-5.5 mb-8">
              <div class="flex items-center border-b-2 border-neutral-300 pb-4 mb-5 min-w-0">
                <span class="text-4 font-medium text-black w-28 lg:w-40 shrink-0">Email actuel</span>
                <span class="text-4 font-medium text-neutral-500 truncate min-w-0">{user.email ?? '—'}</span>
              </div>
              {emailSuccess && <p class="text-primary-600 text-sm font-medium mb-4 m-0">Email mis à jour.</p>}
              {emailError   && <p class="text-red-500 text-sm font-medium mb-4 m-0">{emailError}</p>}
              <form method="POST" enctype="application/x-www-form-urlencoded" class="flex flex-col lg:flex-row lg:items-end gap-4">
                <input type="hidden" name="_action" value="change_email" />
                <div class="flex-1">
                  <label class="block text-4 font-medium text-black mb-2">Nouvel email</label>
                  <input type="email" name="new_email" placeholder="nouveau@email.com"
                    class="w-full text-4 font-medium bg-neutral-200 border-2 border-neutral-300 rounded px-4 py-2 outline-none" />
                </div>
                <button type="submit"
                  class="bg-primary-600 text-white text-4 font-medium px-8 py-2.25 hover:opacity-90 transition-opacity cursor-pointer border-0 rounded shrink-0">
                  Modifier
                </button>
              </form>
            </div>

            <!-- Mot de passe -->
            <h3 class="text-black m-0 mb-5">Sécurité</h3>
            <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-7.5 py-5.5 mb-8">
              {pwdSuccess && <p class="text-primary-600 text-sm font-medium mb-4 m-0">Mot de passe modifié.</p>}
              {pwdError   && <p class="text-red-500 text-sm font-medium mb-4 m-0">{pwdError}</p>}
              <form method="POST" enctype="application/x-www-form-urlencoded" class="flex flex-col gap-5">
                <input type="hidden" name="_action" value="change_password" />
                <div>
                  <label class="block text-4 font-medium text-black mb-2">Mot de passe actuel</label>
                  <input type="password" name="old_password" placeholder="••••••••"
                    class="w-full max-w-100 text-4 font-medium bg-neutral-200 border-2 border-neutral-300 rounded px-4 py-2 outline-none" />
                </div>
                <div class="flex flex-col lg:flex-row gap-4">
                  <div class="flex-1">
                    <label class="block text-4 font-medium text-black mb-2">Nouveau mot de passe</label>
                    <input type="password" name="new_password" placeholder="••••••••"
                      class="w-full text-4 font-medium bg-neutral-200 border-2 border-neutral-300 rounded px-4 py-2 outline-none" />
                  </div>
                  <div class="flex-1">
                    <label class="block text-4 font-medium text-black mb-2">Confirmer</label>
                    <input type="password" name="confirm_password" placeholder="••••••••"
                      class="w-full text-4 font-medium bg-neutral-200 border-2 border-neutral-300 rounded px-4 py-2 outline-none" />
                  </div>
                </div>
                <button type="submit"
                  class="inline-flex items-center gap-3 bg-primary-900 text-white text-4 font-medium px-8 py-2.25 hover:opacity-90 transition-opacity cursor-pointer border-0 rounded w-fit">
                  Changer le mot de passe
                </button>
              </form>
            </div>

            <!-- Session -->
            <h3 class="text-black m-0 mb-5">Session</h3>
            <div class="bg-white border-0.75 border-neutral-300 rounded-2.5 px-7.5 py-5.5 mb-8">
              <p class="text-4 font-medium text-black m-0 mb-4">
                Connecté en tant que <span class="text-primary-500">{user.pseudo ?? user.email}</span>
              </p>
              <form method="POST" enctype="application/x-www-form-urlencoded">
                <input type="hidden" name="_action" value="logout" />
                <button type="submit"
                  class="inline-flex items-center gap-3 border-2 border-neutral-800 text-neutral-800 text-4 font-medium px-8 py-2.25 hover:bg-neutral-800 hover:text-white transition-colors cursor-pointer bg-transparent rounded">
                  Se déconnecter
                </button>
              </form>
            </div>

            <!-- Zone dangereuse -->
            <h3 class="text-black m-0 mb-5">Zone dangereuse</h3>
            <div class="bg-white rounded-2.5 px-7.5 py-5.5" style="border: 3px solid #fecaca;">
              <div class="flex items-center justify-between gap-8">
                <div>
                  <p class="text-4 font-medium text-black m-0">Supprimer mon compte</p>
                  <p class="text-sm text-neutral-500 m-0 mt-1">Action irréversible. Toutes vos données seront supprimées définitivement.</p>
                </div>
                <form method="POST" enctype="application/x-www-form-urlencoded" id="delete-form" class="shrink-0">
                  <input type="hidden" name="_action" value="delete" />
                  <button type="button" id="delete-btn"
                    class="inline-flex items-center gap-2 border-2 border-red-500 text-red-500 text-4 font-medium px-6 py-2.25 hover:bg-red-500 hover:text-white transition-colors cursor-pointer bg-transparent rounded">
                    Supprimer
                  </button>
                </form>
              </div>
            </div>

          </div>
        </div>

        <!-- ============================= -->
        <!-- PANEL : AMIS (mobile only)  -->
        <!-- ============================= -->
        <div id="panel-amis" data-panel class={activeTab !== 'amis' ? 'hidden' : ''}>
          <div class="px-4 pt-8 pb-16">

            <div class="flex items-center gap-4 mb-8">
              <h2 class="text-black m-0 shrink-0">Amis</h2>
              <div class="flex-1 h-0.5 bg-neutral-300"></div>
            </div>

            <!-- Boutons actions -->
            <div class="flex flex-col gap-3 mb-8">
              <a href="/boutique" class="flex items-center justify-center border-2 border-neutral-800 text-neutral-800 text-4 font-medium h-12 hover:bg-neutral-800 hover:text-white transition-colors no-underline">
                Boutique
              </a>
              <button id="btn-open-friends-mob"
                class="flex items-center justify-center border-2 border-neutral-800 text-neutral-800 text-4 font-medium h-12 hover:bg-neutral-800 hover:text-white transition-colors cursor-pointer bg-transparent">
                Ajouter des amis
              </button>
            </div>

            <!-- Liste des amis -->
            {amiesExpand.length > 0 ? (
              <div class="flex flex-col gap-5">
                {amiesExpand.map(ami => (
                  <a href={`/profil/${ami.id}`} class="flex items-center gap-4 no-underline hover:opacity-80 transition-opacity">
                    <div class="relative shrink-0" style="width:84px; height:84px;">
                      <div class="absolute rounded-full overflow-hidden" style="width:56px; height:56px; top:50%; left:50%; transform:translate(-50%,-50%); z-index:1;">
                        {ami.avatar
                          ? <PbImage record={ami} recordImage={ami.avatar} alt={ami.pseudo} class="w-full h-full object-cover" />
                          : <div class="w-full h-full bg-primary-600 flex items-center justify-center">
                              <span class="text-white font-bold text-5">{(ami.pseudo || ami.prenom || '?')[0].toUpperCase()}</span>
                            </div>
                        }
                      </div>
                      {ami.decoUrl && (
                        <div class="absolute inset-0 pointer-events-none" style="z-index:2;">
                          <PbImage src={ami.decoUrl} alt="" class="w-full h-full object-contain" />
                        </div>
                      )}
                    </div>
                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5">
                        <p class="text-neutral-800 font-bold text-4 m-0 truncate">{ami.pseudo || ''}</p>
                        {ami.abonnements === 'VIP'     && <Image src={badgeVip}     alt="VIP"     width={18} height={18} class="shrink-0" />}
                        {ami.abonnements === 'Premium' && <Image src={badgePremium} alt="Premium" width={18} height={18} class="shrink-0" />}
                      </div>
                      <p class="text-neutral-500 text-3.5 font-medium m-0 truncate">{`${ami.prenom ?? ''} ${ami.nom ?? ''}`.trim()}</p>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <p class="text-neutral-500 text-4 font-medium m-0">Aucun ami pour l'instant.</p>
            )}

          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- Friend modal -->
  <div id="friend-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.65); z-index:50; align-items:center; justify-content:center;">
    <div style="background:#1e1e1e; width:min(520px,95vw); max-height:80vh; display:flex; flex-direction:column; border-radius:5px; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,0.5);">
      <div style="display:flex; justify-content:space-between; align-items:center; padding:20px 28px; border-bottom:1px solid rgba(255,255,255,0.1);">
        <h3 style="color:white; margin:0; font-size:25px; font-weight:500; letter-spacing:-1px;">Ajouter des amis</h3>
        <button id="friend-modal-close" style="background:transparent; border:none; color:white; font-size:26px; line-height:1; cursor:pointer; opacity:0.6;">×</button>
      </div>
      <div style="padding:14px 28px; border-bottom:1px solid rgba(255,255,255,0.1);">
        <div style="display:flex; align-items:center; gap:12px; background:#2c2c2c; border-radius:5px; padding:0 14px; height:42px;">
          <Image src={searchIcon} alt="" width={14} height={14} class="opacity-40 shrink-0" />
          <input id="friend-search" type="text" placeholder="Rechercher un utilisateur…" style="background:transparent; flex:1; font-size:14px; font-weight:500; outline:none; border:none; color:#f7f1ed;" class="placeholder-neutral-200/40" />
        </div>
      </div>
      <div id="friend-modal-list" style="overflow-y:auto; flex:1; padding:20px 28px;"></div>
    </div>
  </div>

  <script id="friend-data" type="application/json" set:html={JSON.stringify({ allUsers, amiesIds, userId, token, PB_URL })}></script>

  <div id="auth-meta" data-token={token} data-user-id={userId} hidden></div>

  <script is:inline define:vars={{ activeTab, PB_URL: 'https://pbbargo.pierre-mouilleseaux-lhuillier.fr', token, userId, decoRecord, titreRecord, themeRecord }}>
    // profil.js — onglets + mode édition
    function moveIndicator(btn) {
      var indicator = document.getElementById('tab-indicator');
      var list      = document.getElementById('tab-list');
      if (!indicator || !list) return;
      var listRect = list.getBoundingClientRect();
      var btnRect  = btn.getBoundingClientRect();
      indicator.style.left  = (btnRect.left - listRect.left + list.scrollLeft) + 'px';
      indicator.style.width = btnRect.width + 'px';
    }

    function switchTab(name) {
      document.querySelectorAll('[data-panel]').forEach(function(p) { p.classList.add('hidden'); });
      var panel = document.getElementById('panel-' + name);
      if (panel) panel.classList.remove('hidden');
      var btn = document.querySelector('.tab-btn[data-tab="' + name + '"]');
      if (btn) moveIndicator(btn);
      if (name !== 'profil') resetEdit();
    }

    function toggleEdit() {
      var editBtn   = document.getElementById('edit-btn');
      var cancelBtn = document.getElementById('cancel-btn');
      if (!editBtn || !cancelBtn) return;
      var isView = editBtn.style.display !== 'none';
      if (isView) {
        switchTab('profil');
        document.querySelectorAll('.view-field').forEach(function(el) { el.classList.add('hidden'); });
        document.querySelectorAll('.edit-field').forEach(function(el) { el.classList.remove('hidden'); });
        editBtn.style.display   = 'none';
        cancelBtn.style.display = '';
      } else {
        resetEdit();
      }
    }

    function resetEdit() {
      document.querySelectorAll('.view-field').forEach(function(el) { el.classList.remove('hidden'); });
      document.querySelectorAll('.edit-field').forEach(function(el) { el.classList.add('hidden'); });
      var editBtn   = document.getElementById('edit-btn');
      var cancelBtn = document.getElementById('cancel-btn');
      if (editBtn)   editBtn.style.display   = '';
      if (cancelBtn) cancelBtn.style.display = 'none';
    }

    function confirmDelete() {
      if (confirm('Supprimer définitivement votre compte ? Cette action est irréversible.')) {
        var form = document.getElementById('delete-form');
        if (form) form.submit();
      }
    }

    document.querySelectorAll('[data-tab]').forEach(function(btn) {
      btn.addEventListener('click', function() { switchTab(btn.dataset.tab); });
    });

    var initTab = (activeTab || 'profil');
    var initBtn = document.querySelector('.tab-btn[data-tab="' + initTab + '"]');
    if (initBtn) moveIndicator(initBtn);
    var editBtnEl = document.getElementById('edit-btn');
    if (editBtnEl) editBtnEl.addEventListener('click', toggleEdit);
    var cancelBtnEl = document.getElementById('cancel-btn');
    if (cancelBtnEl) cancelBtnEl.addEventListener('click', toggleEdit);
    var deleteBtnEl = document.getElementById('delete-btn');
    if (deleteBtnEl) deleteBtnEl.addEventListener('click', confirmDelete);

    var avatarWrap = document.getElementById('profile-avatar-wrap');
    if (avatarWrap) {
      avatarWrap.addEventListener('click', function() {
        var eb = document.getElementById('edit-btn');
        if (eb && eb.style.display === 'none') {
          var upload = document.getElementById('avatar-upload');
          if (upload) upload.click();
        }
      });
    }

    // inventaire.js
    (function () {
      var equipped = {
        decoration_avatar: decoRecord ? decoRecord.id : null,
        titre: titreRecord ? titreRecord.id : null,
        theme: themeRecord ? themeRecord.id : null,
      };

      var EQUIP_FIELD = { decoration_avatar: 'equiper_avatar_decoration', titre: 'equiper_titre', theme: 'equiper_theme' };

      function showToast(msg, ok) {
        var toast = document.getElementById('inv-toast');
        if (!toast) return;
        toast.textContent = msg;
        toast.style.background = ok ? '#347645' : '#c0392b';
        toast.style.opacity = '1';
        toast.style.transform = 'translateX(-50%) translateY(0)';
        clearTimeout(toast._t);
        toast._t = setTimeout(function () {
          toast.style.opacity = '0';
          toast.style.transform = 'translateX(-50%) translateY(20px)';
        }, 2800);
      }

      function reload() {
        var u = new URL(window.location.href);
        u.searchParams.set('tab', 'inventaire');
        window.location.href = u.toString();
      }

      async function equipItem(btn) {
        var itemId   = btn.dataset.itemId;
        var itemType = btn.dataset.itemType;
        var field    = EQUIP_FIELD[itemType];
        if (!field || !token) return;
        btn.disabled = true;
        btn.textContent = '...';
        try {
          var res = await fetch(PB_URL + '/api/collections/users/records/' + userId, {
            method: 'PATCH',
            headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
            body: JSON.stringify({ [field]: itemId }),
          });
          if (!res.ok) throw new Error();
          var oldId = equipped[itemType];
          if (oldId && oldId !== itemId) updateCard(oldId, itemType, false);
          equipped[itemType] = itemId;
          showToast('Article équipé !', true);
          setTimeout(reload, 800);
        } catch (e) {
          btn.disabled = false;
          btn.textContent = 'Équiper';
          showToast('Erreur, réessayez.', false);
        }
      }

      async function unequipItem(btn) {
        var itemId   = btn.dataset.itemId;
        var itemType = btn.dataset.itemType;
        var field    = EQUIP_FIELD[itemType];
        if (!field || !token) return;
        btn.disabled = true;
        btn.textContent = '...';
        try {
          var res = await fetch(PB_URL + '/api/collections/users/records/' + userId, {
            method: 'PATCH',
            headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
            body: JSON.stringify({ [field]: '' }),
          });
          if (!res.ok) throw new Error();
          equipped[itemType] = null;
          updateCard(itemId, itemType, false);
          showToast('Article retiré.', true);
          setTimeout(reload, 800);
        } catch (e) {
          btn.disabled = false;
          btn.textContent = 'Déséquiper';
          showToast('Erreur, réessayez.', false);
        }
      }

      function updateCard(itemId, itemType, isEquipped) {
        document.querySelectorAll('[data-inv-card="' + itemId + '"]').forEach(function (card) {
          var badge         = card.querySelector('.inv-equipped-badge');
          var equipBtn      = card.querySelector('.inv-equip-btn');
          var equippedState = card.querySelector('.inv-equipped-state');
          if (isEquipped) {
            card.classList.add('ring-2', 'ring-primary-500');
            if (badge)         badge.classList.remove('hidden');
            if (equipBtn)      equipBtn.classList.add('hidden');
            if (equippedState) equippedState.classList.remove('hidden');
          } else {
            card.classList.remove('ring-2', 'ring-primary-500');
            if (badge)         badge.classList.add('hidden');
            if (equipBtn)      equipBtn.classList.remove('hidden');
            if (equippedState) equippedState.classList.add('hidden');
          }
        });
      }

      document.addEventListener('click', function (e) {
        var equipBtn   = e.target && e.target.closest('.inv-equip-btn');
        var unequipBtn = e.target && e.target.closest('.inv-unequip-btn');
        if (equipBtn)   equipItem(equipBtn);
        if (unequipBtn) unequipItem(unequipBtn);
      });
    })();
  </script>

