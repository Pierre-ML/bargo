---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import {
  getRoleSession, getDetailSession, appliquerTransitionAutoSession, decouperDateSession,
  listerAmisPourSession, listerBarsPourSession, listerJeuxPourSession,
} from '../../lib/db.ts';
import SessionPanel from '../../components/SessionPanel.astro';
import SessionModals from '../../components/SessionModals.astro';

if (!Astro.locals.user) return Astro.redirect('/connexion?redirect=' + encodeURIComponent(Astro.url.pathname));
const userId = Astro.locals.user.id;

const { id } = Astro.params;
if (!id) return Astro.redirect('/session');

// Lecture réservée à l'hôte, aux membres et aux invités
const role = getRoleSession(id, userId);
if (!role || !role.acces) return Astro.redirect('/session');

// Lancement / fin automatiques : décidés par le serveur d'après les dates
let statut = appliquerTransitionAutoSession(id) ?? role.session.etat;
if (statut === 'fini') return Astro.redirect('/session');

const detail = getDetailSession(id);
if (!detail) return Astro.redirect('/session');
const session = detail.session;

const avatarPublic = (u) => ({
  id: u.id, pseudo: u.pseudo ?? '', prenom: u.prenom ?? '', nom: u.nom ?? '', avatar: u.avatar ?? null,
});
const barPublic = (b) => ({
  id: b.id, nom: b.nom ?? '', adresse: b.adresse ?? '', image: b.image ?? null,
  lat: b.latitude ?? null, lon: b.longitude ?? null,
});
const jeuPublic = (j) => ({
  id: j.id, nom: j.nom ?? '', description: j.description ?? '', image: j.image ?? null, type_du_jeux: j.type ?? '',
});

const bars  = detail.bars.map(barPublic);
const jeux  = detail.jeu ? [jeuPublic(detail.jeu)] : [];
const amis  = detail.membres.map(avatarPublic);
const samIds = detail.samIds;

const isHote   = role.hote;
const isMembre = role.membre;
const isSam    = role.sam;
const barActuel = session.bar_actuel ?? 0;
const automatique = !!session.automatique;

// Catalogues et amis de l'hôte pour les modales "Ajouter" (inutiles pour les autres)
const allAmies = isHote ? listerAmisPourSession(userId).map(avatarPublic) : [];
const allBars  = isHote ? listerBarsPourSession().map(barPublic) : [];
const allJeux  = isHote ? listerJeuxPourSession().map(jeuPublic) : [];

const isEnCours = statut === 'en_cours';
const depart  = decouperDateSession(session.date_depart);
const arrivee = decouperDateSession(session.date_arrivee);

// "<" échappé pour qu'aucune valeur ne puisse fermer la balise <script>
const pageData = JSON.stringify({
  session: { id: session.id, nom: session.nom, date: depart.date, heure_debut: depart.heure, heure_fin: arrivee.heure, description: session.description, automatique },
  bars, jeux, amis, samIds, invitesIds: isHote ? detail.invitesIds : [],
  allBars, allJeux, allAmies,
  isHote, isMembre, isSam, userId, isEnCours, barActuel,
}).replace(/</g, '\\u003c');
---

<Layout title={`${session.nom ?? 'Session'} — Bargo`}>

<div class="flex flex-col lg:flex-row" style="min-height: calc(100vh - 92px);">
  <div id="session-map" class="flex-1 h-70 lg:h-auto" style="background:#dfdfdf; position:relative; z-index:0;"></div>
  <SessionPanel session={{ nom: session.nom, date: depart.date, heure_debut: depart.heure }} isHote={isHote} isEnCours={isEnCours} />
</div>

<SessionModals />

<!-- JSON data -->
<script id="page-data" type="application/json" set:html={pageData}></script>

<script>
import "../../js/session-detail.js";
</script>

</Layout>
