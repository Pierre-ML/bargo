---
// @ts-nocheck
// Page callback OAuth2 — sans Layout pour éviter les interférences

// Déjà connecté → profil
const tok = Astro.cookies.get('pb_token')?.value;
const uid = Astro.cookies.get('pb_user_id')?.value;
if (tok && uid) return Astro.redirect('/profil');
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Connexion — Bargo</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #1E1E1E;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: Inter, system-ui, sans-serif;
      gap: 16px;
      padding: 24px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner {
      width: 40px; height: 40px;
      border: 3px solid rgba(255,255,255,0.1);
      border-top-color: #72C073;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    p { color: #fff; font-size: 16px; font-weight: 500; text-align: center; }
    .err { color: #f87171; font-size: 14px; display: none; }
    a {
      display: inline-block;
      margin-top: 8px;
      padding: 10px 28px;
      background: #094736;
      color: #fff;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
    }
    a:hover { opacity: 0.85; }
  </style>
</head>
<body>
  <div class="spinner" id="spinner"></div>
  <p id="msg">Connexion en cours…</p>
  <p class="err" id="err"></p>
  <a href="/connexion" id="retry" style="display:none">Réessayer</a>

  <script>
    // @ts-nocheck
    (async function () {
      var params       = new URLSearchParams(window.location.search);
      var code         = params.get('code')  || '';
      var codeVerifier = sessionStorage.getItem('pb_oauth_verifier') || '';
      var redirectUrl  = sessionStorage.getItem('pb_oauth_redirect') || '';

      sessionStorage.removeItem('pb_oauth_state');
      sessionStorage.removeItem('pb_oauth_verifier');
      sessionStorage.removeItem('pb_oauth_redirect');

      function fail(msg) {
        document.getElementById('spinner').style.display = 'none';
        document.getElementById('msg').style.display = 'none';
        var err = document.getElementById('err');
        err.textContent = msg || 'Erreur de connexion.';
        err.style.display = 'block';
        document.getElementById('retry').style.display = 'inline-block';
      }

      if (!code || !codeVerifier || !redirectUrl) {
        fail('Session expirée ou données manquantes. Réessayez.');
        return;
      }

      try {
        // L'échange du code se fait côté serveur : /api/oauth/callback pose
        // directement les cookies httpOnly, sans jamais renvoyer le token au JS.
        var res = await fetch('/api/oauth/callback', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ code: code, codeVerifier: codeVerifier, redirectUrl: redirectUrl }),
        });

        var data = await res.json();

        if (!res.ok || !data.redirect) {
          fail('Erreur ' + res.status + ' — ' + (data.error || 'inconnu') + (data.data ? ' | ' + JSON.stringify(data.data) : ''));
          return;
        }

        window.location.href = data.redirect;

      } catch (e) {
        fail('Erreur réseau : ' + e.message);
      }
    })();
  </script>
</body>
</html>
