                <p class="text-neutral-500 text-4 font-medium m-0">Aucune boisson favorite</p>
                <p class="text-sm text-neutral-500 m-0 mt-2">Cet utilisateur n'a pas encore ajouté de boissons favorites.</p>
              </div>
            )}

          </div>
        </div>

      </div>
    </div>

  </section>

  <style is:global>
    /* Titres de section blancs quand un thème est équipé */
    .theme-active h2,
    .theme-active h3 {
      color: white;
    }
    /* H3 dans les cartes blanches restent noirs */
    .theme-active .bg-white h2,
    .theme-active .bg-white h3 {
      color: rgb(0 0 0);
    }
  </style>

</Layout>

<script is:inline define:vars={{ targetUserId: id, activeTab }}>
  // Les actions passent par /api/amis/* : l'utilisateur courant est lu côté serveur.
  function moveIndicator(btn) {
    var indicator = document.getElementById('tab-indicator');
    var list      = document.getElementById('tab-list');
    if (!indicator || !list) return;
    var listRect = list.getBoundingClientRect();
    var btnRect  = btn.getBoundingClientRect();
    indicator.style.left  = (btnRect.left - listRect.left + list.scrollLeft) + 'px';
    indicator.style.width = btnRect.width + 'px';
  }

  var initBtn = document.querySelector('.tab-btn[data-tab="' + (activeTab || 'profil') + '"]');
  if (initBtn) moveIndicator(initBtn);

  document.querySelectorAll('.tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var tabId = btn.dataset.tab;
      document.querySelectorAll('[data-panel]').forEach(function (p) { p.classList.add('hidden'); });
      var panel = document.getElementById('panel-' + tabId);
      if (panel) panel.classList.remove('hidden');
      moveIndicator(btn);
    });
  });

  function appel(action, btn, apres) {
    if (!btn) return;
    btn.disabled = true; btn.style.opacity = '0.6';
    fetch('/api/amis/' + action, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ami_id: targetUserId }),
    }).then(function (r) {
      if (!r.ok) throw new Error('echec');
      return r.json();
    }).then(apres).catch(function () {
      btn.disabled = false; btn.style.opacity = '1';
    });
  }

  function recharger() { window.location.reload(); }

  function lier(ids, action, apres) {
    ids.forEach(function (idBtn) {
      var b = document.getElementById(idBtn);
      if (b) b.addEventListener('click', function () { appel(action, b, apres(b)); });
    });
  }

  // Envoyer une demande (si l'autre m'avait déjà écrit, on devient amis : rechargement)
  lier(['send-request-btn', 'send-request-btn-mobile'], 'demande', function (b) {
    return function (data) {
      if (data.etat === 'ami') return recharger();
      b.textContent = 'Demande envoyée';
      b.style.background = '#347645';
      b.style.opacity = '1';
    };
  });
  lier(['accept-btn', 'accept-btn-mobile'], 'accepter', function () { return recharger; });
  lier(['refuse-btn', 'refuse-btn-mobile'], 'refuser', function () { return recharger; });
  lier(['remove-friend-btn', 'remove-friend-btn-mobile'], 'supprimer', function () { return recharger; });
</script>
