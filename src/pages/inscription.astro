---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { registerUser, loginUser } from '../../backend/backend.js';
import bgImg      from '../assets/img/fond_connextion_inscription.avif';
import checkIcon  from '../assets/icon/check.svg';

// Déjà connecté → profil (les deux cookies doivent exister)
const _token  = Astro.cookies.get('pb_token')?.value;
const _userId = Astro.cookies.get('pb_user_id')?.value;
if (_token && _userId) return Astro.redirect('/profil');

let error = '';

if (Astro.request.method === 'POST') {
  const body   = await Astro.request.text();
  const params = new URLSearchParams(body);

  const nom             = params.get('nom')             ?? '';
  const prenom          = params.get('prenom')          ?? '';
  const pseudo          = params.get('pseudo')          ?? '';
  const email           = params.get('email')           ?? '';
  const password        = params.get('password')        ?? '';
  const passwordConfirm = params.get('passwordConfirm') ?? '';
  const terms           = params.get('terms');

  // Validation conditions d'utilisation
  if (!terms) {
    error = "Vous devez accepter les conditions d'utilisation.";
  } else if (password !== passwordConfirm) {
    error = 'Les mots de passe ne correspondent pas.';
  } else if (password.length < 8) {
    error = 'Le mot de passe doit contenir au moins 8 caractères.';
  } else {
    const { record, error: pbError } = await registerUser({
      nom, prenom, pseudo, email, password, passwordConfirm, abonnements: 'Gratuit'
    });

    if (record) {
      const loginResult = await loginUser(email, password);
      if (loginResult?.token) {
        Astro.cookies.set('pb_token',   loginResult.token,     { httpOnly: true, path: '/', maxAge: 60 * 60 * 24 * 7, sameSite: 'lax' });
        Astro.cookies.set('pb_user_id', loginResult.record.id, { httpOnly: true, path: '/', maxAge: 60 * 60 * 24 * 7, sameSite: 'lax' });
        return Astro.redirect('/bienvenue');
      }
    }
    error = pbError?.message ?? 'Une erreur est survenue lors de la création du compte.';
  }
}
---

<Layout title="Inscription — Bargo">

  <!-- ===== MOBILE ===== -->
  <section class="block lg:hidden bg-neutral-800 px-5 py-10 min-h-screen">

    <h2 class="text-white m-0 mb-3 uppercase text-8">INSCRIVEZ-VOUS</h2>
    <p class="text-3.5 font-medium leading-tight text-white m-0 mb-6">
      Rejoignez BARGO et organisez votre prochain barathon en quelques minutes.
    </p>

    {error && (
      <p class="text-red-400 text-3.5 font-medium m-0 mb-4">{error}</p>
    )}

    <form method="POST" enctype="application/x-www-form-urlencoded" id="inscription-form-mobile" novalidate class="flex flex-col gap-5">

      <!-- Nom + Prénom -->
      <div class="flex gap-3">
        <div class="flex-1 flex flex-col gap-1">
          <label class="text-white text-3.5 font-medium">Nom</label>
          <div class="bg-neutral-200 rounded-0.75 h-13 flex items-center px-4">
            <input type="text" name="nom" placeholder="Nom" required
              class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
          </div>
        </div>
        <div class="flex-1 flex flex-col gap-1">
          <label class="text-white text-3.5 font-medium">Prénom <span class="text-neutral-300 text-3">(facultatif)</span></label>
          <div class="bg-neutral-200 rounded-0.75 h-13 flex items-center px-4">
            <input type="text" name="prenom" placeholder="Prénom"
              class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
          </div>
        </div>
      </div>

      <!-- Pseudo -->
      <div class="flex flex-col gap-1">
        <label class="text-white text-3.5 font-medium">Pseudo</label>
        <div class="bg-neutral-200 rounded-0.75 h-13 flex items-center px-4">
          <input type="text" name="pseudo" placeholder="Pseudo" required
            class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
        </div>
      </div>

      <!-- Email -->
      <div class="flex flex-col gap-1">
        <label class="text-white text-3.5 font-medium">Adresse E-mail</label>
        <div class="bg-neutral-200 rounded-0.75 h-13 flex items-center px-4">
          <input type="email" name="email" placeholder="Mail" required
            class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
        </div>
      </div>

      <!-- Mot de passe -->
      <div class="flex flex-col gap-1">
        <label class="text-white text-3.5 font-medium">Mots de passe</label>
        <div class="bg-neutral-200 rounded-0.75 h-13 flex items-center px-4">
          <input type="password" name="password" placeholder="Mots de passe" required minlength="8"
            class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
        </div>
      </div>

      <!-- Confirmer mot de passe -->
      <div class="flex flex-col gap-1">
        <label class="text-white text-3.5 font-medium">Confirmer le mot de passe</label>
        <div class="bg-neutral-200 rounded-0.75 h-13 flex items-center px-4">
          <input type="password" name="passwordConfirm" placeholder="Confirmer le mot de passe" required minlength="8"
            class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
        </div>
      </div>

      <!-- Checkbox conditions -->
      <label class="flex items-center gap-4 cursor-pointer">
        <div class="relative w-6.25 h-6.25 shrink-0">
          <input type="checkbox" name="terms" id="terms-checkbox-mobile"
            class="absolute inset-0 opacity-0 w-full h-full cursor-pointer peer" />
          <div class="absolute inset-0 border-2 border-white shadow-md peer-checked:bg-primary-600 peer-checked:border-primary-600 transition-colors pointer-events-none"></div>
          <Image src={checkIcon} alt="" width={16} height={16} class="absolute inset-0 m-auto w-3.5 h-3.5 opacity-0 peer-checked:opacity-100 pointer-events-none brightness-0 invert" />
        </div>
        <span class="text-white text-3.5 font-medium leading-snug">J'accepte les conditions d'utilisation</span>
      </label>

      <!-- Bouton -->
      <button type="submit"
        class="mt-2 bg-primary-600 h-13 w-full flex items-center justify-center text-white text-4 font-medium hover:brightness-110 active:scale-[0.97] transition-all cursor-pointer border-0">
        Créer mon compte
      </button>

      <!-- Séparateur OU -->
      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-white/20"></div>
        <span class="text-white/40 text-3.5 font-medium">ou</span>
        <div class="flex-1 h-px bg-white/20"></div>
      </div>

      <!-- Bouton Google -->
      <button type="button"
        class="btn-google-oauth bg-white h-13 w-full flex items-center justify-center gap-3 text-neutral-800 text-4 font-medium hover:bg-neutral-100 active:scale-[0.97] transition-all cursor-pointer border-0 disabled:opacity-50">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continuer avec Google
      </button>

      <!-- Lien connexion -->
      <p class="text-3.5 font-medium leading-tight text-white m-0 text-center">
        Déjà un compte ?&nbsp;<a href="/connexion" class="underline hover:opacity-70 transition-opacity">Se connecter</a>
      </p>

    </form>
  </section>

  <!-- ===== DESKTOP ===== -->
  <section class="hidden lg:block relative min-h-310 overflow-hidden">

    <!-- Fond sombre (pleine largeur) -->
    <div class="absolute inset-0 bg-neutral-800"></div>

    <!-- Photo droite -->
    <div class="absolute top-0 bottom-0 right-0 overflow-hidden" style="left: max(813px, calc(50% + 93px));">
      <Image src={bgImg} alt="" class="w-full h-full object-cover object-top" />
    </div>

    <!-- Wrapper centré (max-1440px centré) -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 h-full w-full max-w-360 z-10">

    <!-- Erreur serveur -->
    {error && (
      <p class="absolute top-23.75 left-20 text-red-400 text-3.5 font-medium m-0 z-10">{error}</p>
    )}

    <!-- H2 -->
    <h2 class="absolute top-23.75 left-19.75 text-white m-0 uppercase">
      INSCRIVEZ-VOUS
    </h2>

    <!-- Sous-titre -->
    <p class="absolute top-43 left-20 text-3.5 font-medium leading-tight text-white m-0 w-136.75">
      Rejoignez BARGO et organisez votre prochain barathon en quelques minutes.
    </p>

    <form method="POST" enctype="application/x-www-form-urlencoded" id="inscription-form" novalidate>

      <!-- ─── Nom ─── -->
      <label class="absolute top-63.5 left-20 text-white text-4 font-medium leading-snug">Nom</label>
      <div class="absolute top-73.5 left-20 bg-neutral-200 rounded-0.75 h-15.5 w-74 flex items-center px-8">
        <input type="text" name="nom" placeholder="Nom" required
          class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
      </div>

      <!-- ─── Prénom (facultatif) ─── -->
      <div class="absolute top-63.5 flex items-baseline gap-2" style="left: calc(25% + 48px);">
        <label class="text-white text-4 font-medium leading-snug">Prénom</label>
        <span class="text-neutral-300 text-3.5 font-semibold">( facultatif )</span>
      </div>
      <div class="absolute top-73.5 bg-neutral-200 rounded-0.75 h-15.5 w-74 flex items-center px-8" style="left: calc(25% + 48px);">
        <input type="text" name="prenom" placeholder="Prénom"
          class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
      </div>

      <!-- ─── Pseudo ─── -->
      <label class="absolute top-98 left-20 text-white text-4 font-medium leading-snug">Pseudo</label>
      <div class="absolute top-108 left-20 bg-neutral-200 rounded-0.75 h-15.5 w-156 flex items-center px-8">
        <input type="text" name="pseudo" placeholder="Pseudo" required
          class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
      </div>

      <!-- ─── Email ─── -->
      <label class="absolute top-127.5 left-20 text-white text-4 font-medium leading-snug">Adresse E-mail</label>
      <div class="absolute top-137.5 left-20 bg-neutral-200 rounded-0.75 h-15.5 w-156 flex items-center px-8">
        <input type="email" name="email" placeholder="Mail" required
          class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
      </div>

      <!-- ─── Mot de passe ─── -->
      <label class="absolute top-157 left-20 text-white text-4 font-medium leading-snug">Mots de passe</label>
      <div class="absolute top-167 left-20 bg-neutral-200 rounded-0.75 h-15.5 w-156 flex items-center px-8">
        <input type="password" name="password" placeholder="Mots de passe" required minlength="8"
          class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
      </div>

      <!-- ─── Confirmer mot de passe ─── -->
      <label class="absolute top-187.5 left-20 text-white text-4 font-medium leading-snug">Confirmer le mot de passe</label>
      <div class="absolute top-197.5 left-20 bg-neutral-200 rounded-0.75 h-15.5 w-156 flex items-center px-8">
        <input type="password" name="passwordConfirm" placeholder="Confirmer le mot de passe" required minlength="8"
          class="bg-transparent w-full text-3.5 font-medium text-neutral-500 placeholder-neutral-500 outline-none" />
      </div>

      <!-- ─── Mot de passe oublié ─── -->
      <p class="absolute top-218 left-20 text-3.5 font-medium leading-tight text-neutral-300 m-0">
        Mot de passe oublié ?
      </p>

      <!-- ─── Checkbox conditions d'utilisation ─── -->
      <label class="absolute top-229 left-20 flex items-center gap-5.5 cursor-pointer">
        <div class="relative w-6.25 h-6.25 shrink-0">
          <input type="checkbox" name="terms" id="terms-checkbox"
            class="absolute inset-0 opacity-0 w-full h-full cursor-pointer peer" />
          <div class="absolute inset-0 border-2 border-white shadow-md peer-checked:bg-primary-600 peer-checked:border-primary-600 transition-colors pointer-events-none"></div>
          <Image src={checkIcon} alt="" width={16} height={16} class="absolute inset-0 m-auto w-3.5 h-3.5 opacity-0 peer-checked:opacity-100 pointer-events-none brightness-0 invert" />
        </div>
        <span class="text-white text-4 font-medium leading-snug">J'accepte les conditions d'utilisation</span>
      </label>

      <!-- ─── Bouton Créer mon compte ─── -->
      <button type="submit" id="submit-btn"
        class="absolute top-239 bg-primary-600 h-15 w-59.25 flex items-center justify-center text-white text-4 font-medium leading-snug hover:brightness-110 active:scale-[0.97] transition-all cursor-pointer border-0 disabled:opacity-40 disabled:cursor-not-allowed"
        style="left: calc(25% + 107px);">
        Créer mon compte
      </button>

      <!-- ─── Séparateur OU ─── -->
      <div class="absolute top-258 flex items-center gap-3 w-59.25 pointer-events-none" style="left: calc(25% + 107px);">
        <div class="flex-1 h-px bg-white/20"></div>
        <span class="text-white/40 text-3.5 font-medium">ou</span>
        <div class="flex-1 h-px bg-white/20"></div>
      </div>

      <!-- ─── Bouton Google ─── -->
      <button type="button"
        class="btn-google-oauth absolute top-265 bg-white h-15 w-59.25 flex items-center justify-center gap-3 text-neutral-800 text-4 font-medium hover:bg-neutral-100 active:scale-[0.97] transition-all cursor-pointer border-0 disabled:opacity-50"
        style="left: calc(25% + 107px);">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continuer avec Google
      </button>

      <!-- ─── Lien connexion ─── -->
      <p class="absolute top-286 text-3.5 font-medium leading-tight text-white m-0"
        style="left: calc(25% + 344px); transform: translateX(-100%);">
        Déjà un compte ?&nbsp;<a href="/connexion" class="underline hover:opacity-70 transition-opacity">Se connecter</a>
      </p>

    </form>
    </div><!-- /wrapper centré -->
  </section>

  <script>
    import '../js/inscription.js';
    import '../js/oauth-google.js';
  </script>
</Layout>
