---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Faq from '../components/Faq.astro';
import Partenaires from '../components/Partenaires.astro';

import heroBg       from '../assets/img/hero_aPropos.avif';
import naissanceImg from '../assets/img/jeux-img-4.avif';
import visionImg    from '../assets/img/jeux-img-5.avif';
import membre1      from '../assets/img/melvyn_philippon.avif';
import membre2      from '../assets/img/pierre_mouilleseaux_lhuillier.avif';
import membre3      from '../assets/img/alex_ringenbach.avif';
---

<Layout>

  <!-- ==================== HERO ==================== -->
  <section class="relative h-100 lg:h-175 overflow-hidden">
    <Image src={heroBg} alt="" class="absolute inset-0 w-full h-full object-cover pointer-events-none" />
    <div class="absolute inset-0 bg-linear-to-b from-[rgba(30,30,30,0.7)] to-neutral-800"></div>
    <h1 class="absolute bottom-10 lg:top-124.5 right-5 lg:right-20 text-right text-white uppercase m-0 text-10 lg:text-22.5 w-[calc(100%-40px)] lg:w-231.75">
      Qui somme-nous
    </h1>
  </section>

  <!-- ==================== LA NAISSANCE DU PROJET ==================== -->

  <!-- Mobile -->
  <section class="lg:hidden bg-neutral-200 px-5 py-10">
    <h2 class="text-black m-0 mb-6 text-7">La naissance du projet</h2>
    <div class="w-full h-55 rounded-2.5 overflow-hidden mb-6">
      <Image src={naissanceImg} alt="La naissance du projet" class="w-full h-full object-cover block pointer-events-none" />
    </div>
    <p class="text-neutral-500 m-0">
      BARGO est né d'un constat simple : organiser une tournée de bars entre amis devient vite compliqué.
      Messages dispersés, choix des bars au dernier moment, absence d'itinéraire clair…
      L'idée est alors apparue de créer une plateforme dédiée à l'organisation des barathons,
      afin de structurer l'expérience tout en conservant l'aspect convivial.
    </p>
  </section>

  <!-- Desktop -->
  <section class="hidden lg:block relative h-121 bg-neutral-200 overflow-visible z-2">
    <h2 class="absolute top-24 left-20 text-black m-0 w-101.25">
      La naissance du projet
    </h2>
    <p class="absolute top-63.5 left-20 w-128.75 text-neutral-500 m-0">
      BARGO est né d'un constat simple : organiser une tournée de bars entre amis devient vite compliqué.
      Messages dispersés, choix des bars au dernier moment, absence d'itinéraire clair…
      L'idée est alors apparue de créer une plateforme dédiée à l'organisation des barathons,
      afin de structurer l'expérience tout en conservant l'aspect convivial.
    </p>
    <div class="absolute top-17 left-[calc(50%+16px)] w-176 h-141.75 rounded-tl-2.5 rounded-bl-2.5 overflow-hidden">
      <Image src={naissanceImg} alt="La naissance du projet" class="w-full h-full object-cover block pointer-events-none" />
    </div>
  </section>

  <!-- ==================== NOTRE VISION / NOS OBJECTIFS ==================== -->

  <!-- Mobile -->
  <section class="lg:hidden bg-neutral-800 px-5 py-10">
    <h2 class="text-white m-0 mb-6 text-7">Notre vision</h2>
    <p class="text-neutral-300 m-0 mb-8">
      BARGO ne se limite pas à l'organisation d'une soirée. Le projet vise à proposer une expérience
      collective structurée, où convivialité et responsabilité vont de pair.
    </p>
    <div class="w-full h-55 rounded-2.5 overflow-hidden mb-8">
      <Image src={visionImg} alt="Notre vision" class="w-full h-full object-cover block pointer-events-none" />
    </div>
    <h2 class="text-white m-0 mb-4 text-7">Nos objectifs</h2>
    <div class="text-neutral-300 flex flex-col gap-3">
      <p class="m-0">Simplifier l'organisation des sorties entre amis</p>
      <p class="m-0">Encourager une approche responsable</p>
      <p class="m-0">Valoriser l'expérience collective</p>
      <p class="m-0">Proposer une interface intuitive et accessible</p>
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden lg:block relative h-199.75 bg-neutral-800 overflow-visible z-1">
    <h2 class="absolute top-25.25 left-20 text-white m-0">
      Notre vision
    </h2>
    <p class="absolute top-53.5 left-20 w-101.25 text-neutral-300 m-0">
      BARGO ne se limite pas à l'organisation d'une soirée. Le projet vise à proposer une expérience
      collective structurée, où convivialité et responsabilité vont de pair.
    </p>
    <div class="absolute top-100 left-0 w-176 h-161 rounded-tr-2.5 rounded-br-2.5 overflow-hidden">
      <Image src={visionImg} alt="Notre vision" class="w-full h-full object-cover block pointer-events-none" />
    </div>
    <h2 class="absolute top-100 left-[calc(58.33%+5px)] text-white m-0">
      Nos objectifs
    </h2>
    <div class="absolute top-137 left-[calc(58.33%+5px)] w-101.5 text-neutral-300">
      <p class="m-0">Simplifier l'organisation des sorties entre amis</p>
      <p class="m-0">&nbsp;</p>
      <p class="m-0">Encourager une approche responsable</p>
      <p class="m-0">&nbsp;</p>
      <p class="m-0">Valoriser l'expérience collective</p>
      <p class="m-0">&nbsp;</p>
      <p class="m-0">Proposer une interface intuitive et accessible</p>
    </div>
  </section>

  <!-- ==================== COLLABORATION + ÉQUIPE ==================== -->

  <!-- Mobile -->
  <section class="lg:hidden bg-neutral-200 px-5 py-10">
    <h2 class="text-black m-0 mb-4 text-7">Une collaboration collective</h2>
    <p class="text-neutral-800 m-0 mb-10">
      Ce projet a pu voir le jour grâce à la coordination de notre équipe et au soutien de nos nombreux
      partenaires. Leur collaboration et leur engagement ont contribué à faire de BARGO une plateforme
      cohérente et aboutie.
    </p>

    <!-- Melvyn -->
    <div class="flex items-start gap-5 mb-10">
      <div class="shrink-0 w-22.5 h-22.5 rounded-tl-full rounded-tr-full rounded-bl-full overflow-hidden">
        <Image src={membre1} alt="Melvyn Philippon" class="w-full h-full object-cover block pointer-events-none" />
      </div>
      <div>
        <h2 class="text-primary-500 m-0 mb-1 text-5">Notre Designer</h2>
        <h3 class="text-neutral-800 m-0 mb-2">Melvyn Philippon</h3>
        <p class="text-neutral-500 m-0 text-3.5">
          Responsable de l'identité visuelle et de l'expérience utilisateur, il a conçu l'univers graphique
          de BARGO ainsi que l'interface.
        </p>
      </div>
    </div>

    <!-- Pierre -->
    <div class="flex items-start gap-5 mb-10">
      <div class="shrink-0 w-22.5 h-22.5 rounded-tl-full rounded-tr-full rounded-br-full overflow-hidden">
        <Image src={membre2} alt="Pierre Mouilleseaux-Lhuillier" class="w-full h-full object-cover block pointer-events-none" />
      </div>
      <div>
        <h2 class="text-primary-500 m-0 mb-1 text-5">Notre Développeur</h2>
        <h3 class="text-neutral-800 m-0 mb-2">Pierre Mouilleseaux-Lhuillier</h3>
        <p class="text-neutral-500 m-0 text-3.5">
          En charge de la conception technique, il a structuré l'architecture du site et développé les
          fonctionnalités principales.
        </p>
      </div>
    </div>

    <!-- Alex -->
    <div class="flex items-start gap-5">
      <div class="shrink-0 w-22.5 h-22.5 rounded-tl-full rounded-tr-full rounded-bl-full overflow-hidden">
        <Image src={membre3} alt="Alex Ringenbach" class="w-full h-full object-cover block pointer-events-none" />
      </div>
      <div>
        <h2 class="text-primary-500 m-0 mb-1 text-5">Notre responsable Communication</h2>
        <h3 class="text-neutral-800 m-0 mb-2">Alex Ringenbach</h3>
        <p class="text-neutral-500 m-0 text-3.5">
          Il définit la stratégie de communication et l'image du projet. Il s'occupe de la cohérence du
          discours et de la mise en avant des valeurs de BARGO.
        </p>
      </div>
    </div>
  </section>

  <!-- Desktop -->
  <section class="hidden lg:block relative h-520 bg-neutral-200">

    <h2 class="absolute top-91 left-20 text-black m-0 w-128.75">
      Une collaboration collective
    </h2>
    <p class="absolute top-93.75 left-[calc(50%+16px)] w-156 text-neutral-800 m-0">
      Ce projet a pu voir le jour grâce à la coordination de notre équipe et au soutien de nos nombreux
      partenaires. Leur collaboration et leur engagement ont contribué à faire de BARGO une plateforme
      cohérente et aboutie.
    </p>

    <!-- Melvyn -->
    <div class="absolute top-167 left-20 w-74 h-74 rounded-tl-full rounded-tr-full rounded-bl-full overflow-hidden">
      <Image src={membre1} alt="Melvyn Philippon" class="w-full h-full object-cover block pointer-events-none" />
    </div>
    <h2 class="absolute top-167 left-[calc(25%+48px)] text-primary-500 m-0">Notre Designer</h2>
    <h3 class="absolute top-185 left-[calc(25%+48px)] text-neutral-800 m-0 w-74">Melvyn Philippon</h3>
    <p class="absolute top-204 left-[calc(25%+48px)] w-128.75 text-neutral-500 m-0">
      Responsable de l'identité visuelle et de l'expérience utilisateur, il a conçu l'univers graphique
      de BARGO ainsi que l'interface. Son objectif : proposer une navigation claire, moderne et cohérente
      avec les valeurs du projet.
    </p>

    <!-- Pierre -->
    <div class="absolute top-274.5 left-[calc(16.67%+59px)] w-74 h-74 rounded-tl-full rounded-tr-full rounded-br-full overflow-hidden">
      <Image src={membre2} alt="Pierre Mouilleseaux-Lhuillier" class="w-full h-full object-cover block pointer-events-none" />
    </div>
    <h2 class="absolute top-274.5 left-[calc(41.67%+27px)] text-primary-500 m-0">Notre Développeur</h2>
    <h3 class="absolute top-292.5 left-[calc(41.67%+27px)] text-neutral-800 m-0 w-101.25">Pierre Mouilleseaux-Lhuillier</h3>
    <p class="absolute top-311.5 left-[calc(41.67%+27px)] w-128.5 text-neutral-500 m-0">
      En charge de la conception technique, il a structuré l'architecture du site et développé les
      fonctionnalités principales. Il veille à la performance, à la fluidité et au bon fonctionnement
      de la plateforme.
    </p>

    <!-- Alex -->
    <div class="absolute top-382 left-20 w-74 h-74 rounded-tl-full rounded-tr-full rounded-bl-full overflow-hidden">
      <Image src={membre3} alt="Alex Ringenbach" class="w-full h-full object-cover block pointer-events-none" />
    </div>
    <h2 class="absolute top-382 left-[calc(25%+48px)] text-primary-500 m-0 w-128.75">Notre responsable Communication</h2>
    <h3 class="absolute top-412.5 left-[calc(25%+48px)] text-neutral-800 m-0 w-74">Alex Ringenbach</h3>
    <p class="absolute top-431.5 left-[calc(25%+48px)] w-128.75 text-neutral-500 m-0">
      Il définit la stratégie de communication et l'image du projet. Il s'occupe de la cohérence du
      discours, de la présentation du concept et de la mise en avant des valeurs de BARGO.
    </p>

  </section>

  <!-- ==================== PARTENAIRES ==================== -->
  <Partenaires />

  <!-- ==================== SORTIR ENSEMBLE ==================== -->

  <!-- Mobile -->
  <section class="lg:hidden bg-neutral-200 px-5 py-10">
    <h2 class="text-black m-0 mb-6 text-7">Sortir ensemble, en toute responsabilité</h2>
    <p class="text-neutral-500 m-0">
      Un barathon doit rester un moment convivial et maîtrisé. Pensez à organiser votre retour à l'avance,
      à désigner un conducteur pour la soirée et à respecter vos limites. L'abus d'alcool est dangereux
      pour la santé. Consommez avec modération.
    </p>
  </section>

  <!-- Desktop -->
  <section class="hidden lg:block relative h-126.75 bg-neutral-200">
    <h2 class="absolute top-34 left-20 text-black m-0 w-183.25">
      Sortir ensemble, en toute responsabilité
    </h2>
    <p class="absolute top-66 left-[calc(58.33%+5px)] w-128.75 text-neutral-500 m-0">
      Un barathon doit rester un moment convivial et maîtrisé. Pensez à organiser votre retour à l'avance,
      à désigner un conducteur pour la soirée et à respecter vos limites. L'abus d'alcool est dangereux
      pour la santé. Consommez avec modération.
    </p>
  </section>

  <!-- ==================== FAQ ==================== -->
  <Faq />

</Layout>
