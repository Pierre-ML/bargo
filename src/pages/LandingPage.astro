          <p id="lp-adr-a"  class="absolute left-19.5 top-53.5 w-54.5 text-base font-medium leading-snug text-black">{barsData[0].adresse}</p>
          <p id="lp-desc-a" class="absolute left-19.5 top-85.75 w-44.25 text-sm font-medium leading-tight text-neutral-500">{barsData[0].description}</p>
          <a id="lp-link-a" href={`/bar/${barsData[0].id}`} class="absolute left-19.5 top-131.5 w-54.5 h-20 bg-neutral-800 inline-flex items-center justify-center text-white text-base font-medium no-underline hover:bg-primary-900 transition-colors">En savoir plus</a>
          <div class="absolute left-82 top-39 w-109.5 h-126.25 rounded-r-2.5 overflow-hidden shadow-[-15px_15px_30px_0px_rgba(0,0,0,0.25)]">
            <img id="lp-img-a" src={barsData[0].cardImgUrl || undefined} alt="" class="w-full h-full object-cover block" />
          </div>
        </div>
        <div id="lp-card-b" class="absolute left-0 top-0 w-full h-full" style="transform:translateX(-100%)">
          <div class="absolute left-0 top-39 w-82 h-126.25 bg-white rounded-l-2.5 shadow-[-15px_15px_30px_0px_rgba(0,0,0,0.15)]"></div>
          <p id="lp-adr-b"  class="absolute left-19.5 top-53.5 w-54.5 text-base font-medium leading-snug text-black"></p>
          <p id="lp-desc-b" class="absolute left-19.5 top-85.75 w-44.25 text-sm font-medium leading-tight text-neutral-500"></p>
          <a id="lp-link-b" href="#" class="absolute left-19.5 top-131.5 w-54.5 h-20 bg-neutral-800 inline-flex items-center justify-center text-white text-base font-medium no-underline hover:bg-primary-900 transition-colors">En savoir plus</a>
          <div class="absolute left-82 top-39 w-109.5 h-126.25 rounded-r-2.5 overflow-hidden shadow-[-15px_15px_30px_0px_rgba(0,0,0,0.25)]">
            <PbImage id="lp-img-b" alt="" class="w-full h-full object-cover block" />
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <button id="lp-bar-prev" aria-label="Bar précédent" class="flex absolute left-238.75 top-177 w-16.25 h-16.25 bg-transparent border-0 cursor-pointer items-center justify-center z-10 hover:scale-110 active:scale-95 transition-transform">
        <div class="absolute w-11.5 h-11.5 bg-primary-500 rounded-full"></div>
        <Image src={chevronLeftIcon} alt="" width={18} height={18} class="relative z-1 brightness-0 invert" />
      </button>
      <button id="lp-bar-next" aria-label="Bar suivant" class="flex absolute left-266 top-177 w-16.25 h-16.25 bg-transparent border-0 cursor-pointer items-center justify-center z-10 hover:scale-110 active:scale-95 transition-transform">
        <div class="absolute w-11.5 h-11.5 bg-primary-500 rounded-full"></div>
        <Image src={chevronRightIcon} alt="" width={18} height={18} class="relative z-1 brightness-0 invert" />
      </button>
      <p id="lp-bar-counter" class="block absolute left-308.5 top-181.25 text-neutral-200 text-base font-medium leading-snug whitespace-nowrap z-10">1 / {barsData.length}</p>
      <div class="absolute left-39.25 top-0 w-px h-67.5 bg-[rgba(247,241,237,0.35)] z-10"></div>
      <div class="absolute left-39.25 top-131.75 w-px bottom-0 bg-[rgba(247,241,237,0.35)] z-10"></div>

    </div><!-- /desktop wrapper -->

    <!-- Mobile: carte bar -->
    <div class="block lg:hidden absolute inset-0">
      <!-- Image de fond (moitié basse) -->
      <div class="absolute left-0 top-81 w-full h-119.5 overflow-hidden">
        <img id="lp-mob-bg-src" src={barsData[0].parallaxUrl || undefined} alt="" class="w-full h-full object-cover block" />
        <div class="absolute inset-0 bg-linear-to-b from-[rgba(30,30,30,0)] to-[rgba(30,30,30,0.45)]"></div>
      </div>

      <!-- Carte blanche -->
      <div id="lp-mob-card" class="absolute top-6.75 left-6.25 w-86 h-104 bg-white rounded-1.25 shadow-[-7px_7px_15px_0px_rgba(0,0,0,0.25)] overflow-hidden">
        <div class="w-full h-54.25 overflow-hidden rounded-t-1.25 shrink-0">
          <img id="lp-mob-img" src={barsData[0].cardImgUrl || undefined} alt="" class="w-full h-full object-cover block" />
        </div>
        <p id="lp-mob-adr"  class="absolute left-4.5 top-60 w-67.5 text-base font-medium leading-snug text-neutral-800">{barsData[0].adresse}</p>
        <p id="lp-mob-desc" class="absolute left-4.5 top-71.75 w-50 text-sm font-medium leading-tight text-neutral-500">{barsData[0].descriptionMob}</p>
        <button id="lp-mob-prev" aria-label="Précédent" class="absolute left-4.5 top-89.25 w-7.75 h-7.75 bg-primary-500 border-0 rounded-full cursor-pointer flex items-center justify-center hover:scale-110 active:scale-95 transition-transform">
          <Image src={chevronLeftIcon} alt="" width={10} height={10} class="brightness-0" />
        </button>
        <button id="lp-mob-next" aria-label="Suivant" class="absolute left-16 top-89.25 w-7.75 h-7.75 bg-primary-500 border-0 rounded-full cursor-pointer flex items-center justify-center hover:scale-110 active:scale-95 transition-transform">
          <Image src={chevronRightIcon} alt="" width={10} height={10} class="brightness-0" />
        </button>
        <a id="lp-mob-link" href={`/bar/${barsData[0].id}`} class="absolute right-4.5 top-88.25 w-40.5 h-10 bg-neutral-800 inline-flex items-center justify-center text-white text-sm font-medium no-underline hover:bg-primary-900 transition-colors">En savoir plus</a>
      </div>

      <!-- Nom du bar -->
      <h2 id="lp-mob-nom" class="absolute top-125 left-15 text-white text-12.5 tracking-0.75 leading-none w-69">{barsData[0].nom}</h2>
    </div>

  </section>
)}

<!-- ========== VALEURS CAROUSEL ========== -->
<section id="vision" class="relative w-full h-184 lg:h-190.25 overflow-hidden bg-white">

  <!-- Track (width:300% = 3 slides × section width) -->
  <div id="lp-val-track" class="absolute top-0 left-0 h-full flex w-[300%]">
    {valeurs.map((v, i) => (
      <div class="shrink-0 w-1/3 h-full relative bg-transparent lg:bg-white">
