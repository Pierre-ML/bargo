---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';

const token  = Astro.cookies.get('pb_token')?.value;
const userId = Astro.cookies.get('pb_user_id')?.value;
if (!token || !userId) return Astro.redirect('/connexion');

const sessionId = Astro.url.searchParams.get('session') ?? '';

const cardOptions = [
  { value: '8',  label: '8 cartes' },
  { value: '12', label: '12 cartes' },
  { value: '16', label: '16 cartes' },
];

const timeOptions = [
  { value: '0',   label: 'Sans limite' },
  { value: '60',  label: '1 min' },
  { value: '120', label: '2 min' },
  { value: '180', label: '3 min' },
];

const steps = [
  'Choisissez le nombre de cartes et le temps limite.',
  'Cliquez sur deux cartes pour les retourner.',
  'Si elles correspondent, elles restent visibles.',
  'Sinon, elles se retournent et vous perdez une vie.',
  'Trouvez toutes les paires avant de perdre vos 3 vies !',
];
---

<Layout title="Memory Shot — Bargo">

  <!-- HERO -->
  <section class="bg-primary-900 h-70 lg:h-112.5 relative">
    <h1 class="absolute top-15 left-5 lg:top-35.25 lg:left-20 text-white m-0 uppercase text-10 lg:text-22.5">Memory</h1>
    <p class="block lg:hidden absolute bottom-6 left-5 right-5 text-neutral-300 text-3.5 font-medium m-0 leading-snug">
      Retrouvez les paires de boissons le plus vite possible !
    </p>
    <p class="hidden lg:block absolute top-67 left-20 text-neutral-200 text-3.5 font-medium w-136.75 m-0 leading-relaxed">
      Enchaînez les paires de boissons, testez votre concentration et défiez vos amis.<br />
      Attention, vous n'avez que 3 vies !
    </p>
  </section>

  <!-- CONTENU -->
  <div class="bg-neutral-200 px-4 lg:px-20 py-10 lg:py-20">
    <div class="max-w-360 mx-auto">
      <div class="flex flex-col lg:flex-row gap-10 lg:gap-20">

        <!-- Gauche : règles + points -->
        <div class="lg:w-1/2">
          <h2 class="m-0 mb-6 text-black">Comment jouer</h2>

          <div class="flex flex-col gap-5 mb-8">
            {steps.map((rule, i) => (
              <div class="flex gap-4 items-start">
                <span class="w-8 h-8 rounded-full bg-primary-900 text-white flex items-center justify-center text-4 font-bold shrink-0">{i + 1}</span>
                <p class="m-0 text-black text-4 font-medium leading-normal">{rule}</p>
              </div>
            ))}
          </div>

          <!-- Points -->
          <div class="bg-neutral-800 rounded-0.5 p-6">
            <h3 class="text-white m-0 mb-1">Points à gagner</h3>
            <p class="m-0 mb-4 text-neutral-300 text-3.5 font-medium opacity-70">
              Vous commencez avec <strong class="text-white">nb paires + 2 vies</strong> (ex : 8 paires = 10 vies).
              Moins de temps = multiplicateur plus élevé.
            </p>
            <div class="flex flex-col gap-2 mb-4">
              {[
                { label: 'Sans limite',  pts: '×1',   detail: '10 pts/paire' },
                { label: '3 min',        pts: '×1.5', detail: '15 pts/paire' },
                { label: '2 min',        pts: '×2',   detail: '20 pts/paire' },
                { label: '1 min',        pts: '×3',   detail: '30 pts/paire' },
              ].map(row => (
                <div class="flex items-center justify-between gap-4">
                  <p class="m-0 text-neutral-200 text-3.5 font-medium">{row.label}</p>
                  <div class="flex items-center gap-3 shrink-0">
                    <span class="text-neutral-300 text-3.5 font-medium opacity-60">{row.pts}</span>
                    <span class="text-primary-500 text-4 font-bold">{row.detail}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="border-t border-neutral-700 pt-3 flex flex-col gap-2">
              {[
                { label: 'Bonus par vie restante',       pts: '+5 pts' },
                { label: 'Bonus finir avant la limite',  pts: '+20 pts' },
              ].map(row => (
                <div class="flex items-center justify-between gap-4">
                  <p class="m-0 text-neutral-200 text-3.5 font-medium">{row.label}</p>
                  <span class="text-primary-500 text-4 font-bold">{row.pts}</span>
                </div>
              ))}
            </div>
            <p class="m-0 mt-3 text-neutral-300 text-3 font-medium opacity-50">Les points sont attribués uniquement pendant une session.</p>
          </div>
        </div>

        <!-- Droite : paramètres + lancer -->
        <div class="lg:w-1/2">
          <form id="memory-form">

            <!-- Nombre de cartes -->
            <div class="mb-8">
              <h3 class="m-0 mb-4 text-black">Nombre de cartes</h3>
              <div class="flex flex-wrap gap-3">
                {cardOptions.map((opt, i) => (
                  <label class="cursor-pointer">
                    <input type="radio" name="cards" value={opt.value} class="peer sr-only" checked={i === 2} />
                    <span class="peer-checked:bg-neutral-800 peer-checked:text-white block px-5 py-3 border-2 border-neutral-800 rounded-0.5 text-4 font-medium text-black transition-colors">
                      {opt.label}
                    </span>
                  </label>
                ))}
              </div>
              <p class="m-0 mt-2 text-neutral-500 text-3.5 font-medium">Toujours un nombre pair (autant de paires à trouver).</p>
            </div>

            <!-- Temps limite -->
            <div class="mb-10">
              <h3 class="m-0 mb-4 text-black">Temps limite</h3>
              <div class="flex flex-wrap gap-3">
                {timeOptions.map((opt, i) => (
                  <label class="cursor-pointer">
                    <input type="radio" name="time" value={opt.value} class="peer sr-only" checked={i === 0} />
                    <span class="peer-checked:bg-neutral-800 peer-checked:text-white block px-5 py-3 border-2 border-neutral-800 rounded-0.5 text-4 font-medium text-black transition-colors">
                      {opt.label}
                    </span>
                  </label>
                ))}
              </div>
            </div>

            <button type="submit"
              class="w-full lg:w-auto px-12 h-14 bg-neutral-800 text-white text-4 font-medium hover:opacity-90 transition-opacity cursor-pointer border-0">
              Lancer le jeu
            </button>

          </form>
        </div>

      </div>
    </div>
  </div>

  <script is:inline define:vars={{ sessionId }}>
    document.getElementById('memory-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var data  = new FormData(this);
      var cards = data.get('cards') || '16';
      var time  = data.get('time')  || '0';
      var url   = '/jeux_memoire/jouer?cards=' + cards + '&time=' + time;
      if (sessionId) url += '&session=' + sessionId;
      window.location.href = url;
    });
  </script>

</Layout>
