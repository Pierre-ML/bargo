# =====================================================================
# BARGO : variables d'environnement (copier ce fichier en .env)
# Aucune de ces variables ne doit être préfixée par PUBLIC_ : ce préfixe
# les injecterait dans le JS envoyé au navigateur.
# =====================================================================

# Chemin du fichier SQLite (créé automatiquement au premier démarrage)
DATABASE_PATH=data/bargo.db

# Dossier des fichiers envoyés (images des bars, avatars...)
UPLOAD_DIR=data/uploads

# Secret de better-auth (signature des cookies de session). Obligatoire,
# différent par environnement, jamais commité. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# URL publique du site (https en production : les cookies deviennent Secure)
BETTER_AUTH_URL=http://localhost:4321
